+// M33: definitions the PS4 build needs and its libraries leave out.
+
+// FFmpeg 7.1 (the sysroot's, built with --disable-everything and only the decoders PSP games use,
+// as for the rpcs3 port): the H.264 decoder's SEI code frees AV1 film grain parameters, whose
+// source isn't built. PSP movies never carry them, so there is nothing to free.
+void ff_aom_uninit_film_grain_params(void *s) {
+	(void)s;
+}
diff --git a/ps4/PS4VulkanWSI.cpp b/ps4/PS4VulkanWSI.cpp
new file mode 100644
index 0000000..606695d
--- /dev/null
+++ b/ps4/PS4VulkanWSI.cpp
@@ -0,0 +1,649 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: Vulkan window system integration on the PS4 (Resonance's ps4_wsi.cpp, from Crema's
+// PS4WSI.cpp).
+//
+// RADV (DolphinPS4's GNM port) is linked into the executable and has no WSI. This file adds
+// VK_EXT_headless_surface and VK_KHR_swapchain on top of it the way DolphinPS4 presents: the
+// swapchain images are linear R8G8B8A8 images in host-visible memory (GPU address = CPU address
+// on the PS4), registered as VideoOut buffers, and presenting queues a VideoOut flip behind the
+// GPU work submitted so far (ac_ps4_submit_flip in the Mesa winsys). PPSSPP's VulkanContext keeps
+// using the standard surface/swapchain API (WINDOWSYSTEM_HEADLESS) through
+// ps4_vk_get_instance_proc_addr(), which VulkanLoader.cpp loads everything from.
+#include "Common/CommonTypes.h"
+#include "Common/Log.h"
+#include "ps4/PS4VulkanWSI.h"
+
+#define VK_NO_PROTOTYPES
+#include "ext/vulkan/vulkan.h"
+#include <orbis/VideoOut.h>
+#include <orbis/libkernel.h>
+#include <orbis/SystemService.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_common_GetDeviceProcAddr(VkDevice device, const char *name);
+// port/mesa/ac_ps4_drm.c: queues a VideoOut flip behind the submitted GPU work (GPU-side flip)
+extern "C" int ac_ps4_submit_flip(int video, unsigned buffer, unsigned mode, int64_t arg);
+
+namespace
+{
+constexpr u32 kMaxImages = 4;
+constexpr VkDeviceSize kFramebufferAlign = 2 << 20;	// VideoOut buffer alignment
+
+struct PS4Surface
+{
+	u32 magic = 0x50533453;
+};
+
+struct PS4Swapchain
+{
+	VkDevice device;
+	u32 imageCount;
+	VkImage images[kMaxImages] {};
+	VkDeviceMemory memory[kMaxImages] {};
+	int bufferSet = -1;
+	int firstBuffer = 0;
+	u32 nextImage = 0;
+	u32 flipMode = ORBIS_VIDEO_OUT_FLIP_VSYNC;
+};
+
+VkInstance sInstance = VK_NULL_HANDLE;
+VkPhysicalDevice sPhysicalDevice = VK_NULL_HANDLE;
+VkDevice sDevice = VK_NULL_HANDLE;  // for QueueSubmit
+int sVideo = -1;
+OrbisKernelEqueue sFlipQueue;
+u64 sFlipsSubmitted = 0;
+// VideoOut's 16 buffer slots, as 4 banks of kMaxImages: a swapchain takes a free bank. A bank
+// comes free only once VideoOut lets go of it: sceVideoOutUnregisterBuffers fails while one of
+// its buffers is on screen (or still queued to be, the flips being the GPU's), which is just when
+// PPSSPP destroys the old swapchain after making the new one. Such a set is parked (its memory
+// kept: the screen may still be showing it) and released after the next flips. (Alternating
+// between two fixed banks without checking leaked one on the third swapchain, and then every new
+// one failed with 0x80290010: no picture at all.)
+constexpr int kBanks = 4;
+bool sBankUsed[kBanks] {};
+struct PS4Swapchain;
+std::vector<PS4Swapchain *> sRetired;
+std::mutex sMutex;
+
+template<typename T>
+T Device(VkDevice device, const char *name) {
+	return (T)vk_common_GetDeviceProcAddr(device, name);
+}
+
+template<typename T>
+T Instance(const char *name) {
+	return (T)vk_icdGetInstanceProcAddr(sInstance, name);
+}
+
+bool OpenVideoOut()
+{
+	if (sVideo >= 0)
+		return true;
+	sVideo = sceVideoOutOpen(0xFF, 0, 0, nullptr);
+	if (sVideo < 0)
+	{
+		ERROR_LOG(Log::G3D, "PS4WSI: sceVideoOutOpen failed: %x", sVideo);
+		return false;
+	}
+	sceKernelCreateEqueue(&sFlipQueue, "m33 flip");
+	sceVideoOutAddFlipEvent(sFlipQueue, sVideo, nullptr);
+	return true;
+}
+
+// appends one extension to an enumeration result (count/properties two-call idiom)
+VkResult AppendExtensions(std::vector<VkExtensionProperties>& list, std::initializer_list<std::pair<const char *, u32>> extra,
+		u32 *count, VkExtensionProperties *props)
+{
+	for (const auto& [name, specVersion] : extra)
+	{
+		VkExtensionProperties p {};
+		strncpy(p.extensionName, name, VK_MAX_EXTENSION_NAME_SIZE - 1);
+		p.specVersion = specVersion;
+		list.push_back(p);
+	}
+	if (props == nullptr)
+	{
+		*count = (u32)list.size();
+		return VK_SUCCESS;
+	}
+	const u32 n = std::min<u32>(*count, (u32)list.size());
+	memcpy(props, list.data(), n * sizeof(VkExtensionProperties));
+	*count = n;
+	return n < list.size() ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+std::vector<const char *> WithoutExtensions(u32 count, const char *const *names, std::initializer_list<const char *> drop)
+{
+	std::vector<const char *> result;
+	for (u32 i = 0; i < count; i++)
+		if (std::none_of(drop.begin(), drop.end(), [&](const char *d) { return strcmp(names[i], d) == 0; }))
+			result.push_back(names[i]);
+	return result;
+}
