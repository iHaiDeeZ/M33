+namespace {
+
+struct Face {
+	FT_Face face = nullptr;
+	std::vector<uint8_t> data;  // (FreeType reads a font loaded from the VFS from this memory)
+	std::string name;
+};
+
+enum Dir { NEUTRAL, LTR, RTL };
+
+bool IsRtl(uint32_t c) {
+	return (c >= 0x0590 && c <= 0x08FF) || (c >= 0xFB1D && c <= 0xFDFF) || (c >= 0xFE70 && c <= 0xFEFF);
+}
+
+class TextDrawerPS4 : public TextDrawer {
+public:
+	explicit TextDrawerPS4(Draw::DrawContext *draw) : TextDrawer(draw) {
+		if (FT_Init_FreeType(&lib_) != 0) {
+			ERROR_LOG(Log::G3D, "M33 text: FreeType didn't start");
+			lib_ = nullptr;
+		}
+		buf_ = hb_buffer_create();
+		dpiScale_ = CalculateDPIScale();
+	}
+	~TextDrawerPS4() override {
+		ClearCache();
+		ClearFonts();
+		hb_buffer_destroy(buf_);
+		if (lib_)
+			FT_Done_FreeType(lib_);
+	}
+
+	bool IsReady() const override { return lib_ != nullptr; }
+
+	void SetOrCreateFont(const FontStyle &style) override {
+		fontStyle_ = style;
+		const std::string file = GetFilenameForFontStyle(style) + ".ttf";
+		auto it = primary_.find(file);
+		if (it == primary_.end()) {
+			auto face = std::make_unique<Face>();
+			size_t size = 0;
+			uint8_t *bytes = g_VFS.ReadFile(file.c_str(), &size);
+			if (bytes) {
+				face->data.assign(bytes, bytes + size);
+				delete[] bytes;
+				if (FT_New_Memory_Face(lib_, face->data.data(), (FT_Long)face->data.size(), 0, &face->face) != 0)
+					face->face = nullptr;
+			}
+			if (!face->face)
+				ERROR_LOG(Log::G3D, "M33 text: couldn't load %s", file.c_str());
+			face->name = file;
+			it = primary_.emplace(file, std::move(face)).first;
+		}
+		cur_ = it->second->face;
+		px_ = std::max(4, (int)(style.sizePts / dpiScale_ * 1.25f));
+		bold_ = ((int)style.flags & (int)FontStyleFlags::Bold) != 0;
+	}
+
+	bool DrawStringBitmap(std::vector<uint8_t> &bitmapData, TextStringEntry &entry, Draw::DataFormat texFormat, std::string_view str, int align, bool fullColor) override;
+
+protected:
+	void MeasureStringInternal(std::string_view str, float *w, float *h) override {
+		Layout layout;
+		DoLayout(str, &layout);
+		*w = (float)std::max(1, layout.width);
+		*h = (float)std::max(1, layout.height);
+	}
+	bool SupportsColorEmoji() const override { return false; }
+	void ClearFonts() override {
+		for (auto &h : hb_)
+			hb_font_destroy(h.second);  // (before the faces: each holds a reference to its face)
+		hb_.clear();
+		for (auto &p : primary_)
+			if (p.second->face)
+				FT_Done_Face(p.second->face);
+		primary_.clear();
+		for (auto &f : fallbacks_)
+			if (f->face)
+				FT_Done_Face(f->face);
+		fallbacks_.clear();
+		fallbacksLoaded_ = false;
+		glyphFace_.clear();
+		cur_ = nullptr;
+	}
+
+private:
+	struct Glyph {
+		FT_Face face;
+		FT_UInt index;
+		int x, y;  // on its line, from the pen position and the baseline (up)
+	};
+	struct Line {
+		std::vector<Glyph> glyphs;
+		int width = 0;
+	};
+	struct Layout {
+		std::vector<Line> lines;
+		int width = 0, height = 0, lineHeight = 0, ascent = 0;
+	};
+
+	void LoadFallbacks();
+	FT_Face FaceFor(uint32_t c);
+	hb_font_t *HbFor(FT_Face face) {
+		auto it = hb_.find(face);
+		if (it == hb_.end())
+			it = hb_.emplace(face, hb_ft_font_create_referenced(face)).first;
+		return it->second;
+	}
+	void SetSize(FT_Face face) {
+		FT_Set_Pixel_Sizes(face, 0, px_);
+	}
+	bool LoadGlyph(FT_Face face, FT_UInt index) {
+		SetSize(face);
+		if (FT_Load_Glyph(face, index, FT_LOAD_DEFAULT | FT_LOAD_TARGET_NORMAL) != 0)
+			return false;
+		if (bold_ && face != cur_)
+			FT_GlyphSlot_Embolden(face->glyph);
+		if (face->glyph->format != FT_GLYPH_FORMAT_BITMAP)
+			return FT_Render_Glyph(face->glyph, FT_RENDER_MODE_NORMAL) == 0;
+		return true;
+	}
+	void LayoutLine(const std::vector<uint32_t> &text, Line *line, int *ascent, int *descent);
+	void DoLayout(std::string_view str, Layout *layout);
+
+	FT_Library lib_ = nullptr;
+	hb_buffer_t *buf_ = nullptr;
+	std::map<std::string, std::unique_ptr<Face>> primary_;
+	std::vector<std::unique_ptr<Face>> fallbacks_;
+	bool fallbacksLoaded_ = false;
+	std::unordered_map<uint32_t, int> glyphFace_;  // character -> fallback (-2: none has it)
+	std::unordered_map<FT_Face, hb_font_t *> hb_;
+	FT_Face cur_ = nullptr;
+	int px_ = 16;
+	bool bold_ = false;
+};
+
+void TextDrawerPS4::LoadFallbacks() {
+	fallbacksLoaded_ = true;
+	const std::string lang = g_Config.sLanguageIni;
+	const std::string sys = "/preinst/common/font/";
+	// Japanese, Chinese, Korean: the current language's first (its Han shapes)
+	std::vector<std::pair<std::string, std::string>> cjk = {
+		{ "ja", "SSTJpPro-Regular.otf" }, { "zh", "DFHEI5-SONY.ttf" }, { "ko", "SCEPS4Yoongd-Medium.otf" },
+	};
+	std::vector<std::pair<std::string, std::string>> bundled = {
+		{ "ja", "fonts/NotoSansJP-Regular.otf" }, { "zh", "fonts/NotoSansSC-Regular.otf" }, { "ko", "fonts/NotoSansKR-Regular.otf" },
+	};
+	auto first = [&](std::vector<std::pair<std::string, std::string>> &v) {
+		std::stable_partition(v.begin(), v.end(), [&](const auto &e) { return startsWith(lang, e.first); });
+	};
+	first(cjk);
+	first(bundled);
+
+	auto addFile = [&](const std::string &path) {
+		auto face = std::make_unique<Face>();
+		face->name = path;
+		if (FT_New_Face(lib_, path.c_str(), 0, &face->face) == 0) {
+			fallbacks_.push_back(std::move(face));
+			return true;
+		}
+		return false;
+	};
+	auto addAsset = [&](const std::string &path) {
+		if (addFile("/app0/assets/" + path))  // read from the package as needed
+			return true;
+		auto face = std::make_unique<Face>();
+		face->name = path;
+		size_t size = 0;
+		uint8_t *bytes = g_VFS.ReadFile(path.c_str(), &size);
+		if (!bytes)
+			return false;
+		face->data.assign(bytes, bytes + size);
+		delete[] bytes;
+		if (FT_New_Memory_Face(lib_, face->data.data(), (FT_Long)face->data.size(), 0, &face->face) != 0)
+			return false;
+		fallbacks_.push_back(std::move(face));
+		return true;
+	};
+	int system = 0, packaged = 0;
+	// The packaged CJK font only where the console's own can't be opened (17 MB we'd rather not hold)
+	for (size_t i = 0; i < cjk.size(); i++) {
+		if (addFile(sys + cjk[i].second))
+			system++;
+		else if (addAsset(bundled[i].second))
+			packaged++;
+	}
+	system += addFile(sys + "SST-Roman.otf");
+	// Scripts the PS4 has no font for (its SSTArabic lacks Kurdish and Persian letters)
+	for (const char *f : { "fonts/NotoSansArabic-Regular.ttf", "fonts/NotoSansHebrew-Regular.ttf", "fonts/NotoSansThai-Regular.ttf",
+		"fonts/NotoSansKhmer-Regular.ttf", "fonts/NotoSansLao-Regular.ttf", "fonts/NotoSansSymbols2-Regular.ttf" }) {
+		if (addAsset(f))
+			packaged++;
+		else
+			ERROR_LOG(Log::G3D, "M33 text: couldn't load %s", f);
+	}
+	NOTICE_LOG(Log::G3D, "M33 text: %d system fonts, %d packaged ones as fallbacks (language %s)", system, packaged, lang.c_str());
+}
+
+FT_Face TextDrawerPS4::FaceFor(uint32_t c) {
+	if (cur_ && FT_Get_Char_Index(cur_, c))
+		return cur_;
+	auto it = glyphFace_.find(c);
+	if (it == glyphFace_.end()) {
+		if (!fallbacksLoaded_)
+			LoadFallbacks();
+		int found = -2;
+		for (size_t i = 0; i < fallbacks_.size(); i++) {
+			if (FT_Get_Char_Index(fallbacks_[i]->face, c)) {
+				found = (int)i;
+				break;
+			}
+		}
+		it = glyphFace_.emplace(c, found).first;
+	}
+	return it->second >= 0 ? fallbacks_[it->second]->face : cur_;  // (cur_: its "missing" box)
+}
+
+void TextDrawerPS4::LayoutLine(const std::vector<uint32_t> &text, Line *line, int *ascent, int *descent) {
+	const size_t n = text.size();
+	if (!n)
+		return;
+	hb_unicode_funcs_t *ucd = hb_unicode_funcs_get_default();
+	auto isMark = [&](uint32_t c) {
+		const hb_unicode_general_category_t g = hb_unicode_general_category(ucd, c);
+		return g == HB_UNICODE_GENERAL_CATEGORY_NON_SPACING_MARK || g == HB_UNICODE_GENERAL_CATEGORY_SPACING_MARK ||
+			g == HB_UNICODE_GENERAL_CATEGORY_ENCLOSING_MARK || c == 0x200C || c == 0x200D;
+	};
+	auto isNeutral = [&](uint32_t c) {
+		switch (hb_unicode_general_category(ucd, c)) {
+		case HB_UNICODE_GENERAL_CATEGORY_SPACE_SEPARATOR: case HB_UNICODE_GENERAL_CATEGORY_CONTROL:
+		case HB_UNICODE_GENERAL_CATEGORY_CONNECT_PUNCTUATION: case HB_UNICODE_GENERAL_CATEGORY_DASH_PUNCTUATION:
+		case HB_UNICODE_GENERAL_CATEGORY_CLOSE_PUNCTUATION: case HB_UNICODE_GENERAL_CATEGORY_FINAL_PUNCTUATION:
+		case HB_UNICODE_GENERAL_CATEGORY_INITIAL_PUNCTUATION: case HB_UNICODE_GENERAL_CATEGORY_OTHER_PUNCTUATION:
+		case HB_UNICODE_GENERAL_CATEGORY_OPEN_PUNCTUATION: case HB_UNICODE_GENERAL_CATEGORY_MATH_SYMBOL:
+		case HB_UNICODE_GENERAL_CATEGORY_OTHER_SYMBOL: case HB_UNICODE_GENERAL_CATEGORY_MODIFIER_SYMBOL:
+		case HB_UNICODE_GENERAL_CATEGORY_CURRENCY_SYMBOL:
+			return true;
+		default:
+			return false;
+		}
+	};
+
+	// Each character's font and direction. Marks and punctuation stay in the font of the letter
+	// before them where it has them, so a word is shaped in one piece.
+	std::vector<FT_Face> faces(n);
+	std::vector<Dir> dirs(n);
+	Dir para = NEUTRAL;
+	for (size_t i = 0; i < n; i++) {
+		const uint32_t c = text[i];
+		const bool mark = isMark(c);
+		dirs[i] = mark ? (i ? dirs[i - 1] : NEUTRAL) : IsRtl(c) ? RTL : isNeutral(c) ? NEUTRAL : LTR;
+		if (para == NEUTRAL && dirs[i] != NEUTRAL)
+			para = dirs[i];
+		if ((mark || dirs[i] == NEUTRAL) && i && faces[i - 1] && FT_Get_Char_Index(faces[i - 1], c))
+			faces[i] = faces[i - 1];
+		else
+			faces[i] = FaceFor(c);
+	}
+	if (para == NEUTRAL)
+		para = LTR;
+	// Spaces and punctuation between two letters of one direction take it, else the line's
+	for (size_t i = 0; i < n;) {
+		if (dirs[i] != NEUTRAL) {
+			i++;
+			continue;
+		}
+		size_t j = i;
+		while (j < n && dirs[j] == NEUTRAL)
+			j++;
+		const Dir before = i ? dirs[i - 1] : para, after = j < n ? dirs[j] : para;
+		std::fill(dirs.begin() + i, dirs.begin() + j, before == after ? before : para);
+		i = j;
+	}
+
+	// Runs of one direction and font, in reading order; then in the order they're seen
+	struct Run {
+		size_t start, len;
+		Dir dir;
+		FT_Face face;
+	};
+	std::vector<Run> runs;
+	for (size_t i = 0; i < n;) {
+		size_t j = i + 1;
+		while (j < n && dirs[j] == dirs[i] && faces[j] == faces[i])
+			j++;
+		runs.push_back({ i, j - i, dirs[i], faces[i] });
+		i = j;
+	}
+	std::vector<Run> visual;
+	for (size_t i = 0; i < runs.size();) {
+		size_t j = i + 1;
+		while (j < runs.size() && runs[j].dir == runs[i].dir)
+			j++;
+		std::vector<Run> group(runs.begin() + i, runs.begin() + j);
+		if (runs[i].dir == RTL)
+			std::reverse(group.begin(), group.end());
+		if (para == RTL)
+			visual.insert(visual.begin(), group.begin(), group.end());
+		else
+			visual.insert(visual.end(), group.begin(), group.end());
+		i = j;
+	}
+
+	hb_position_t pen = 0;  // 26.6
+	for (const Run &run : visual) {
+		if (!run.face)
+			continue;
+		SetSize(run.face);
+		const FT_Size_Metrics &m = run.face->size->metrics;
+		*ascent = std::max(*ascent, (int)((m.ascender + 63) >> 6));
+		*descent = std::max(*descent, (int)((-m.descender + 63) >> 6));
+		hb_font_t *font = HbFor(run.face);
+		hb_ft_font_changed(font);
+		hb_buffer_reset(buf_);
+		hb_buffer_add_utf32(buf_, text.data(), (int)n, (unsigned)run.start, (int)run.len);
+		hb_buffer_set_direction(buf_, run.dir == RTL ? HB_DIRECTION_RTL : HB_DIRECTION_LTR);
+		hb_buffer_guess_segment_properties(buf_);
+		hb_shape(font, buf_, nullptr, 0);
+		unsigned count = 0;
+		const hb_glyph_info_t *info = hb_buffer_get_glyph_infos(buf_, &count);
+		const hb_glyph_position_t *pos = hb_buffer_get_glyph_positions(buf_, &count);
+		for (unsigned g = 0; g < count; g++) {
+			line->glyphs.push_back({ run.face, info[g].codepoint, (int)((pen + pos[g].x_offset + 32) >> 6), (int)((pos[g].y_offset + 32) >> 6) });
+			pen += pos[g].x_advance;
+		}
+	}
+	line->width = (int)((pen + 63) >> 6);
+}
+
+void TextDrawerPS4::DoLayout(std::string_view str, Layout *layout) {
+	if (!cur_)
+		return;
+	SetSize(cur_);
+	const FT_Size_Metrics &m = cur_->size->metrics;
+	int ascent = (int)((m.ascender + 63) >> 6), descent = (int)((-m.descender + 63) >> 6);
+	std::vector<std::string_view> lines;
+	SplitString(str, '\n', lines);
+	if (lines.empty())
+		lines.push_back(std::string_view());
+	for (std::string_view textLine : lines) {
+		std::vector<uint32_t> text;
+		UTF8 decoder(textLine);
+		while (!decoder.end()) {
+			const uint32_t c = decoder.next();
+			if (c != '\r')
+				text.push_back(c);
+		}
+		Line line;
+		LayoutLine(text, &line, &ascent, &descent);
+		layout->width = std::max(layout->width, line.width);
+		layout->lines.push_back(std::move(line));
+	}
+	layout->ascent = ascent;
+	layout->lineHeight = std::max(1, ascent + descent);
+	layout->height = layout->lineHeight * (int)layout->lines.size();
+}
+
+bool TextDrawerPS4::DrawStringBitmap(std::vector<uint8_t> &bitmapData, TextStringEntry &entry, Draw::DataFormat texFormat, std::string_view str, int align, bool fullColor) {
+	if (str.empty() || !cur_) {
+		bitmapData.clear();
+		return false;
+	}
+	Layout layout;
+	DoLayout(str, &layout);
+	const int w = (std::max(1, layout.width) + 3) & ~3, h = std::max(1, layout.height);
+	std::vector<uint8_t> alpha((size_t)w * h, 0);
+	for (size_t li = 0; li < layout.lines.size(); li++) {
+		const Line &line = layout.lines[li];
+		int x0 = 0;
+		if (align & ALIGN_HCENTER)
+			x0 = (w - line.width) / 2;
+		else if (align & ALIGN_RIGHT)
+			x0 = w - line.width;
+		const int baseline = (int)li * layout.lineHeight + layout.ascent;
+		for (const Glyph &g : line.glyphs) {
+			if (!LoadGlyph(g.face, g.index))
+				continue;
+			const FT_GlyphSlot slot = g.face->glyph;
+			const FT_Bitmap &bm = slot->bitmap;
+			if (bm.pixel_mode != FT_PIXEL_MODE_GRAY)
+				continue;
+			const int gx = x0 + g.x + slot->bitmap_left, gy = baseline - g.y - slot->bitmap_top;
+			for (unsigned y = 0; y < bm.rows; y++) {
+				const int ty = gy + (int)y;
+				if (ty < 0 || ty >= h)
+					continue;
+				const uint8_t *src = bm.buffer + (ptrdiff_t)y * bm.pitch;
+				for (unsigned x = 0; x < bm.width; x++) {
+					const int tx = gx + (int)x;
+					if (tx < 0 || tx >= w)
+						continue;
+					uint8_t &d = alpha[(size_t)ty * w + tx];
+					d = std::max(d, src[x]);
+				}
+			}
+		}
+	}
+	entry.texture = nullptr;
+	entry.bmWidth = entry.width = w;
+	entry.bmHeight = entry.height = h;
+	entry.lastUsedFrame = frameCount_;
+	if (texFormat == Draw::DataFormat::B4G4R4A4_UNORM_PACK16 || texFormat == Draw::DataFormat::R4G4B4A4_UNORM_PACK16) {
+		bitmapData.resize((size_t)w * h * sizeof(uint16_t));
+		uint16_t *out = (uint16_t *)bitmapData.data();
+		for (size_t i = 0; i < alpha.size(); i++)
+			out[i] = AlphaToPremul4444(alpha[i]);
+	} else if (texFormat == Draw::DataFormat::R8_UNORM) {
+		bitmapData = std::move(alpha);
+	} else {
+		_assert_msg_(false, "Bad TextDrawer format");
+		return false;
+	}
+	return true;
+}
+
+}  // namespace
+
+TextDrawer *CreateTextDrawerPS4(Draw::DrawContext *draw) {
+	return new TextDrawerPS4(draw);
+}
