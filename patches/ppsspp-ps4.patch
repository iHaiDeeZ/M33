diff --git a/ps4/PS4StartupClip.cpp b/ps4/PS4StartupClip.cpp
new file mode 100644
index 0000000..f2b0e93
--- /dev/null
+++ b/ps4/PS4StartupClip.cpp
@@ -0,0 +1,356 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: the startup clip, with the FFmpeg the emulator links anyway.
+//
+// The sound is decoded whole when the clip opens (seconds of 48 kHz stereo, a few MB) and handed to
+// PS4Audio as an overlay when the picture starts. The picture is decoded by a thread, a few frames
+// ahead, as RGBA; the UI thread uploads the frame for the current time into one of four textures
+// in turn (a texture the GPU may still be reading isn't written) and draws it over black, letterboxed.
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/imgutils.h>
+#include <libswresample/swresample.h>
+#include <libswscale/swscale.h>
+}
+
+#include "Common/GPU/thin3d.h"
+#include "Common/Log.h"
+#include "Common/Math/geom2d.h"
+#include "Common/Render/DrawBuffer.h"
+#include "Common/Thread/ThreadUtil.h"
+#include "Common/UI/Context.h"
+#include "ps4/PS4Audio.h"
+#include "ps4/PS4StartupClip.h"
+
+namespace M33Clip {
+
+namespace {
+
+struct Frame {
+	double time;
+	std::vector<uint8_t> rgba;
+};
+
+constexpr int kQueueMax = 6;
+constexpr int kTextures = 4;
+
+std::string g_path;
+bool g_active = false;
+float g_duration = 0.0f;
+int g_width = 0, g_height = 0;
+std::vector<int16_t> g_sound;
+bool g_soundStarted = false;
+
+std::thread g_thread;
+std::atomic<bool> g_stop{ false };
+std::mutex g_lock;
+std::condition_variable g_cv;
+std::deque<Frame> g_queue;
+bool g_decodeDone = false;
+
+Draw::Texture *g_tex[kTextures]{};
+int g_texNext = 0;
+Draw::Texture *g_current = nullptr;
+double g_currentTime = -1.0;
+// What happened, for the log when it closes
+std::atomic<int> g_decoded{ 0 };
+int g_draws = 0, g_shown = 0;
+float g_drawW = 0, g_drawH = 0;
+double g_firstTime = -1.0, g_lastT = 0.0;
+
+// All of the clip's sound as 48 kHz interleaved stereo.
+bool DecodeSound(const std::string &path, std::vector<int16_t> *out) {
+	AVFormatContext *fmt = nullptr;
+	if (avformat_open_input(&fmt, path.c_str(), nullptr, nullptr) < 0)
+		return false;
+	bool ok = false;
+	AVCodecContext *ctx = nullptr;
+	SwrContext *swr = nullptr;
+	AVPacket *pkt = av_packet_alloc();
+	AVFrame *frame = av_frame_alloc();
+	do {
+		if (avformat_find_stream_info(fmt, nullptr) < 0)
+			break;
+		const int si = av_find_best_stream(fmt, AVMEDIA_TYPE_AUDIO, -1, -1, nullptr, 0);
+		if (si < 0)
+			break;
+		const AVCodec *codec = avcodec_find_decoder(fmt->streams[si]->codecpar->codec_id);
+		if (!codec)
+			break;
+		ctx = avcodec_alloc_context3(codec);
+		avcodec_parameters_to_context(ctx, fmt->streams[si]->codecpar);
+		if (avcodec_open2(ctx, codec, nullptr) < 0)
+			break;
+		AVChannelLayout stereo = AV_CHANNEL_LAYOUT_STEREO;
+		if (swr_alloc_set_opts2(&swr, &stereo, AV_SAMPLE_FMT_S16, 48000, &ctx->ch_layout, ctx->sample_fmt, ctx->sample_rate, 0, nullptr) < 0 || swr_init(swr) < 0)
+			break;
+		auto convert = [&](AVFrame *f) {
+			const int maxOut = (int)av_rescale_rnd(swr_get_delay(swr, ctx->sample_rate) + (f ? f->nb_samples : 0), 48000, ctx->sample_rate, AV_ROUND_UP);
+			if (maxOut <= 0)
+				return;
+			const size_t base = out->size();
+			out->resize(base + (size_t)maxOut * 2);
+			uint8_t *dst = (uint8_t *)(out->data() + base);
+			const int n = swr_convert(swr, &dst, maxOut, f ? (const uint8_t **)f->extended_data : nullptr, f ? f->nb_samples : 0);
+			out->resize(base + (size_t)std::max(0, n) * 2);
+		};
+		while (av_read_frame(fmt, pkt) >= 0) {
+			if (pkt->stream_index == si && avcodec_send_packet(ctx, pkt) >= 0) {
+				while (avcodec_receive_frame(ctx, frame) >= 0)
+					convert(frame);
+			}
+			av_packet_unref(pkt);
+		}
+		avcodec_send_packet(ctx, nullptr);
+		while (avcodec_receive_frame(ctx, frame) >= 0)
+			convert(frame);
+		convert(nullptr);
+		ok = !out->empty();
+	} while (false);
+	av_frame_free(&frame);
+	av_packet_free(&pkt);
+	swr_free(&swr);
+	avcodec_free_context(&ctx);
+	avformat_close_input(&fmt);
+	return ok;
+}
+
+// The picture, a few frames ahead of the screen.
+void DecodePicture(std::string path) {
+	SetCurrentThreadName("M33Clip");
+	AVFormatContext *fmt = nullptr;
+	AVCodecContext *ctx = nullptr;
+	SwsContext *sws = nullptr;
+	AVPacket *pkt = av_packet_alloc();
+	AVFrame *frame = av_frame_alloc();
+	int si = -1;
+	if (avformat_open_input(&fmt, path.c_str(), nullptr, nullptr) >= 0 && avformat_find_stream_info(fmt, nullptr) >= 0 &&
+		(si = av_find_best_stream(fmt, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0)) >= 0) {
+		const AVStream *st = fmt->streams[si];
+		const AVCodec *codec = avcodec_find_decoder(st->codecpar->codec_id);
+		if (codec) {
+			ctx = avcodec_alloc_context3(codec);
+			avcodec_parameters_to_context(ctx, st->codecpar);
+			ctx->thread_count = 3;
+			if (avcodec_open2(ctx, codec, nullptr) < 0)
+				avcodec_free_context(&ctx);
+		}
+	}
+	if (!ctx)
+		NOTICE_LOG(Log::System, "M33Clip: no picture decoder for %s (stream %d)", path.c_str(), si);
+	int64_t firstPts = AV_NOPTS_VALUE;  // times from the first frame (a PSMF's start at 1 s)
+	auto emit = [&](AVFrame *f) {
+		if (!sws)
+			sws = sws_getContext(f->width, f->height, (AVPixelFormat)f->format, g_width, g_height, AV_PIX_FMT_RGBA, SWS_BILINEAR, nullptr, nullptr, nullptr);
+		Frame out;
+		const AVRational tb = fmt->streams[si]->time_base;
+		const int64_t pts = f->best_effort_timestamp != AV_NOPTS_VALUE ? f->best_effort_timestamp : 0;
+		if (firstPts == AV_NOPTS_VALUE)
+			firstPts = pts;
+		out.time = std::max<int64_t>(0, pts - firstPts) * av_q2d(tb);
+		out.rgba.resize((size_t)g_width * g_height * 4);
+		uint8_t *dst[1] = { out.rgba.data() };
+		int stride[1] = { g_width * 4 };
+		sws_scale(sws, f->data, f->linesize, 0, f->height, dst, stride);
+		std::unique_lock<std::mutex> lock(g_lock);
+		g_cv.wait(lock, [] { return g_stop || (int)g_queue.size() < kQueueMax; });
+		if (!g_stop) {
+			if (g_decoded++ == 0)
+				g_firstTime = out.time;
+			g_queue.push_back(std::move(out));
+		}
+	};
+	if (ctx) {
+		while (!g_stop && av_read_frame(fmt, pkt) >= 0) {
+			if (pkt->stream_index == si && avcodec_send_packet(ctx, pkt) >= 0) {
+				while (!g_stop && avcodec_receive_frame(ctx, frame) >= 0)
+					emit(frame);
+			}
+			av_packet_unref(pkt);
+		}
+		avcodec_send_packet(ctx, nullptr);
+		while (!g_stop && avcodec_receive_frame(ctx, frame) >= 0)
+			emit(frame);
+	}
+	sws_freeContext(sws);
+	av_frame_free(&frame);
+	av_packet_free(&pkt);
+	avcodec_free_context(&ctx);
+	avformat_close_input(&fmt);
+	std::lock_guard<std::mutex> guard(g_lock);
+	g_decodeDone = true;
+	g_cv.notify_all();
+}
+
+}  // namespace
+
+bool Open(const std::string &path) {
+	Close();
+	AVFormatContext *fmt = nullptr;
+	if (avformat_open_input(&fmt, path.c_str(), nullptr, nullptr) < 0)
+		return false;
+	bool ok = false;
+	if (avformat_find_stream_info(fmt, nullptr) >= 0) {
+		const int vi = av_find_best_stream(fmt, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+		if (vi >= 0) {
+			const AVCodecParameters *par = fmt->streams[vi]->codecpar;
+			// at most 1080p (the screen)
+			const float scale = std::min(1.0f, std::min(1920.0f / par->width, 1080.0f / par->height));
+			g_width = std::max(2, (int)(par->width * scale)) & ~1;
+			g_height = std::max(2, (int)(par->height * scale)) & ~1;
+			g_duration = fmt->duration > 0 ? (float)(fmt->duration / (double)AV_TIME_BASE) : 0.0f;
+			ok = true;  // (a PSMF's program stream may not say how long it is)
+		}
+	}
+	avformat_close_input(&fmt);
+	if (!ok) {
+		WARN_LOG(Log::System, "M33Clip: %s isn't a playable clip", path.c_str());
+		return false;
+	}
+	g_sound.clear();
+	if (!DecodeSound(path, &g_sound))
+		WARN_LOG(Log::System, "M33Clip: no sound in %s", path.c_str());
+	g_path = path;
+	g_stop = false;
+	g_decodeDone = false;
+	g_queue.clear();
+	g_soundStarted = false;
+	g_current = nullptr;
+	g_currentTime = -1.0;
+	g_thread = std::thread(DecodePicture, path);
+	g_active = true;
+	NOTICE_LOG(Log::System, "M33Clip: %s, %dx%d, %.2f s, %zu sound frames", path.c_str(), g_width, g_height, g_duration, g_sound.size() / 2);
+	return true;
+}
+
+bool Active() {
+	return g_active;
+}
+
+float Duration() {
+	return g_duration;
+}
+
+void SetSound(std::vector<int16_t> pcm) {
+	g_sound = std::move(pcm);
+}
+
+void Draw(UIContext &dc, const Bounds &bounds, double t) {
+	if (!g_active)
+		return;
+	g_draws++;
+	g_lastT = t;
+	g_drawW = bounds.w;
+	g_drawH = bounds.h;
+	if (!g_soundStarted) {
+		g_soundStarted = true;
+		if (!g_sound.empty())
+			PS4Audio::PlayOverlay(std::move(g_sound));
+		g_sound.clear();
+	}
+	Draw::DrawContext *draw = dc.GetDrawContext();
+	if (!g_tex[0]) {
+		std::vector<uint8_t> black((size_t)g_width * g_height * 4, 0);
+		for (int i = 0; i < kTextures; i++) {
+			Draw::TextureDesc desc{};
+			desc.type = Draw::TextureType::LINEAR2D;
+			desc.format = Draw::DataFormat::R8G8B8A8_UNORM;
+			desc.width = g_width;
+			desc.height = g_height;
+			desc.depth = 1;
+			desc.mipLevels = 1;
+			desc.tag = "M33Clip";
+			desc.initData.push_back(black.data());
+			g_tex[i] = draw->CreateTexture(desc);
+		}
+	}
+	// The newest decoded frame that is due; older due ones are dropped.
+	Frame due;
+	bool have = false;
+	{
+		std::lock_guard<std::mutex> guard(g_lock);
+		while (!g_queue.empty() && g_queue.front().time <= t) {
+			due = std::move(g_queue.front());
+			g_queue.pop_front();
+			have = true;
+		}
+		g_cv.notify_all();
+	}
+	if (have && g_tex[g_texNext]) {
+		const uint8_t *levels[1] = { due.rgba.data() };
+		draw->UpdateTextureLevels(g_tex[g_texNext], levels, Draw::TextureCallback(), 1);
+		g_current = g_tex[g_texNext];
+		g_shown++;
+		g_currentTime = due.time;
+		g_texNext = (g_texNext + 1) % kTextures;
+	}
+
+	dc.Begin();
+	dc.Draw()->Rect(bounds.x, bounds.y, bounds.w, bounds.h, 0xFF000000);
+	dc.Flush();
+	if (g_current) {
+		// letterboxed into the screen
+		const float s = std::min(bounds.w / g_width, bounds.h / g_height);
+		const float w = g_width * s, h = g_height * s;
+		const Bounds pic(bounds.centerX() - w / 2, bounds.centerY() - h / 2, w, h);
+		draw->BindTexture(0, g_current);
+		dc.Draw()->DrawTexRect(pic, 0, 0, 1, 1, 0xFFFFFFFF);
+		dc.Flush();
+		dc.RebindTexture();
+	}
+}
+
+void Close() {
+	if (g_active)
+		NOTICE_LOG(Log::System, "M33Clip: closed %s: %d pictures decoded (first at %.2f s), %d shown in %d draws of %.0fx%.0f, up to %.2f s; textures %s",
+			g_path.c_str(), g_decoded.load(), g_firstTime, g_shown, g_draws, g_drawW, g_drawH, g_lastT, g_tex[0] ? "made" : "none");
+	g_decoded = 0;
+	g_draws = g_shown = 0;
+	g_firstTime = -1.0;
+	g_lastT = 0.0;
+	if (g_thread.joinable()) {
+		{
+			std::lock_guard<std::mutex> guard(g_lock);
+			g_stop = true;
+		}
+		g_cv.notify_all();
+		g_thread.join();
+	}
+	if (g_active)
+		PS4Audio::StopOverlay();
+	for (Draw::Texture *&tex : g_tex) {
+		if (tex)
+			tex->Release();
+		tex = nullptr;
+	}
+	g_current = nullptr;
+	g_queue.clear();
+	g_sound.clear();
+	g_active = false;
+}
+
+}  // namespace M33Clip
