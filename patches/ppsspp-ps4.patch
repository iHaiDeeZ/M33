diff --git a/ps4/PS4Keyboard.cpp b/ps4/PS4Keyboard.cpp
new file mode 100644
index 0000000..220e547
--- /dev/null
+++ b/ps4/PS4Keyboard.cpp
@@ -0,0 +1,197 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: the PS4's own keyboard (the IME dialog), as Resonance's launcher (from Crema's) opens it.
+// It confirms with Cross: the package's param.sfo has ATTRIBUTE 0x2 (scripts/make-pkg.sh), without
+// which system dialogs follow the console's region (Circle on some).
+
+#include <cstddef>
+#include <cstdint>
+#include <orbis/CommonDialog.h>
+#include <orbis/ImeDialog.h>
+#include <orbis/Sysmodule.h>
+#include <orbis/UserService.h>
+
+#include <cstdio>
+#include <mutex>
+#include <string>
+
+#include "Common/Log.h"
+#include "Common/System/Request.h"
+#include "ps4/PS4Keyboard.h"
+
+extern "C" void ps4_boot_trace(const char *line);  // port/ps4_crashlog.cpp
+
+namespace PS4Keyboard {
+
+namespace {
+
+constexpr uint32_t OPTION_NO_AUTO_CAPITALIZATION = 0x2;
+constexpr uint32_t OPTION_PASSWORD = 0x4;  // typed characters shown as dots
+
+std::mutex g_lock;
+bool g_open = false;
+int g_requestId = -1;
+char16_t g_text[1024];
+char16_t g_title[128];
+
+void ToUtf16(const std::string &in, char16_t *out, size_t size) {
+	size_t n = 0;
+	for (size_t i = 0; i < in.size() && n + 2 < size;) {
+		const unsigned char c = in[i];
+		char32_t cp;
+		int len;
+		if (c < 0x80) { cp = c; len = 1; }
+		else if ((c >> 5) == 6) { cp = c & 0x1F; len = 2; }
+		else if ((c >> 4) == 14) { cp = c & 0x0F; len = 3; }
+		else { cp = c & 0x07; len = 4; }
+		for (int k = 1; k < len && i + k < in.size(); k++)
+			cp = (cp << 6) | (in[i + k] & 0x3F);
+		i += len;
+		if (cp >= 0x10000) {
+			cp -= 0x10000;
+			out[n++] = (char16_t)(0xD800 + (cp >> 10));
+			out[n++] = (char16_t)(0xDC00 + (cp & 0x3FF));
+		} else {
+			out[n++] = (char16_t)cp;
+		}
+	}
+	out[n] = 0;
+}
+
+std::string ToUtf8(const char16_t *in) {
+	std::string out;
+	for (size_t i = 0; in[i] != 0; i++) {
+		char32_t cp = in[i];
+		if (cp >= 0xD800 && cp < 0xDC00 && in[i + 1] >= 0xDC00 && in[i + 1] < 0xE000) {
+			cp = 0x10000 + ((cp - 0xD800) << 10) + (in[i + 1] - 0xDC00);
+			i++;
+		}
+		if (cp < 0x80) {
+			out += (char)cp;
+		} else if (cp < 0x800) {
+			out += (char)(0xC0 | (cp >> 6));
+			out += (char)(0x80 | (cp & 0x3F));
+		} else if (cp < 0x10000) {
+			out += (char)(0xE0 | (cp >> 12));
+			out += (char)(0x80 | ((cp >> 6) & 0x3F));
+			out += (char)(0x80 | (cp & 0x3F));
+		} else {
+			out += (char)(0xF0 | (cp >> 18));
+			out += (char)(0x80 | ((cp >> 12) & 0x3F));
+			out += (char)(0x80 | ((cp >> 6) & 0x3F));
+			out += (char)(0x80 | (cp & 0x3F));
+		}
+	}
+	return out;
+}
+
+}  // namespace
+
+bool Open(int requestId, const std::string &title, const std::string &text, bool password) {
+	std::lock_guard<std::mutex> guard(g_lock);
+	if (g_open)
+		return false;
+	static bool loaded = false;
+	if (!loaded) {
+		sceSysmoduleLoadModule(ORBIS_SYSMODULE_IME_DIALOG);
+		sceSysmoduleLoadModuleInternal(ORBIS_SYSMODULE_INTERNAL_COMMON_DIALOG);
+		sceCommonDialogInitialize();
+		loaded = true;
+	}
+	ToUtf16(text, g_text, sizeof(g_text) / sizeof(g_text[0]));
+	ToUtf16(title, g_title, sizeof(g_title) / sizeof(g_title[0]));
+	int32_t user = -1;
+	sceUserServiceGetInitialUser(&user);
+	// Password mode is refused with the default input type (80bc0030): basic Latin, and a
+	// password's length. Should the console still refuse, plainer keyboards follow - a keyboard
+	// that shows the password beats none.
+	struct Attempt {
+		OrbisImeType type;
+		uint32_t option;
+		uint32_t maxLength;
+	};
+	const uint32_t fullLength = (uint32_t)(sizeof(g_text) / sizeof(g_text[0])) - 2;
+	const Attempt passwordAttempts[] = {
+		{ ORBIS_TYPE_BASIC_LATIN, OPTION_PASSWORD, 128 },
+		{ ORBIS_TYPE_BASIC_LATIN, OPTION_PASSWORD, 16 },
+		{ ORBIS_TYPE_DEFAULT, OPTION_PASSWORD, 64 },
+		{ ORBIS_TYPE_BASIC_LATIN, OPTION_NO_AUTO_CAPITALIZATION, 128 },
+	};
+	const Attempt textAttempts[] = {
+		{ ORBIS_TYPE_DEFAULT, OPTION_NO_AUTO_CAPITALIZATION, fullLength },
+	};
+	const Attempt *attempts = password ? passwordAttempts : textAttempts;
+	const size_t count = password ? sizeof(passwordAttempts) / sizeof(Attempt) : 1;
+	int r = -1;
+	for (size_t i = 0; i < count; i++) {
+		OrbisImeDialogSetting setting{};
+		setting.userId = (uint32_t)user;
+		setting.type = attempts[i].type;
+		setting.enterLabel = ORBIS_BUTTON_LABEL_DEFAULT;
+		setting.option = attempts[i].option;
+		setting.maxTextLength = attempts[i].maxLength;
+		setting.inputTextBuffer = reinterpret_cast<wchar_t *>(g_text);
+		setting.posx = 1920.f / 2;
+		setting.posy = 1080.f / 2;
+		setting.horizontalAlignment = ORBIS_H_CENTER;
+		setting.verticalAlignment = ORBIS_V_CENTER;
+		setting.title = reinterpret_cast<const wchar_t *>(g_title);
+		r = sceImeDialogInit(&setting, nullptr);
+		char line[128];
+		snprintf(line, sizeof(line), "keyboard: open %x (type %d, option %x, length %u)", (unsigned)r,
+			(int)attempts[i].type, (unsigned)attempts[i].option, (unsigned)attempts[i].maxLength);
+		ps4_boot_trace(line);
+		if (r >= 0)
+			break;
+	}
+	g_open = r >= 0;
+	g_requestId = g_open ? requestId : -1;
+	return g_open;
+}
+
+bool IsOpen() {
+	std::lock_guard<std::mutex> guard(g_lock);
+	return g_open;
+}
+
+void Update() {
+	int requestId;
+	bool ok;
+	std::string text;
+	{
+		std::lock_guard<std::mutex> guard(g_lock);
+		if (!g_open)
+			return;
+		const OrbisDialogStatus status = sceImeDialogGetStatus();
+		if (status == ORBIS_DIALOG_STATUS_RUNNING)
+			return;
+		OrbisDialogResult result{};
+		if (status == ORBIS_DIALOG_STATUS_STOPPED)
+			sceImeDialogGetResult(&result);
+		sceImeDialogTerm();
+		g_open = false;
+		ok = status == ORBIS_DIALOG_STATUS_STOPPED && result.endstatus == ORBIS_DIALOG_OK;
+		requestId = g_requestId;
+		g_requestId = -1;
+		if (ok)
+			text = ToUtf8(g_text);
+	}
+	if (ok)
+		g_requestManager.PostSystemSuccess(requestId, text);
+	else
+		g_requestManager.PostSystemFailure(requestId);
+}
+
+}  // namespace PS4Keyboard
