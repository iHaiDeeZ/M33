+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: the PSP memory arena on the PS4.
+//
+// The PS4 kernel has no anonymous shared memory to map twice, and can't reserve gigabytes with
+// mmap(PROT_NONE). So, as DolphinPS4's MemArenaPS4 and Resonance's virtual memory do:
+// - the arena is one block of direct (physical) memory,
+// - the 4 GiB the views go into is a sceKernelReserveVirtualRange reservation,
+// - each view maps its part of the block at a fixed address inside the reservation, as often as
+//   the PSP mirrors it (direct memory aliasing, enabled once for the process).
+// Everything maps in 16 KiB pages, the PS4's page size (the scratchpad is exactly one).
+
+#include "ppsspp_config.h"
+
+#if PPSSPP_PLATFORM(PS4)
+
+#include <sys/types.h>
+#include <cstdint>
+#include <initializer_list>
+
+#include "Common/Log.h"
+#include "Common/MemArena.h"
+
+extern "C" {
+// Declared by hand: several OpenOrbis prototypes are wrong.
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t searchStart, off_t searchEnd, size_t length, size_t alignment,
+		int32_t memoryType, off_t *physicalOut);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags,
+		off_t directMemoryStart, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void **address, size_t length, int32_t flags, size_t alignment);
+int32_t sceKernelMunmap(void *address, size_t length);
+int32_t sceKernelEnableDmemAliasing();
+int32_t sceKernelEnableDmemAliasing2();
+}
+
+namespace {
+
+constexpr size_t PAGE = 0x4000;
+constexpr size_t LARGE_PAGE = 0x200000;
+constexpr uint64_t FOUR_GB = 0x100000000ULL;
+constexpr int32_t WB_ONION = 0;        // SCE_KERNEL_WB_ONION
+constexpr int32_t MAP_FIXED_FLAG = 0x10;  // SCE_KERNEL_MAP_FIXED
+constexpr int32_t PROT_CPU_RW = 0x3;
+
+off_t g_dmem = -1;
+size_t g_dmemSize = 0;
+u8 *g_reserved = nullptr;
+size_t g_reservedSize = 0;
+
+size_t AlignUp(size_t v, size_t a) {
+	return (v + a - 1) & ~(a - 1);
+}
+
+bool InReservation(const void *p, size_t size) {
+	return g_reserved && (const u8 *)p >= g_reserved && (const u8 *)p + size <= g_reserved + g_reservedSize;
+}
+
+// Unmaps a range and reserves it again, so nothing else lands in the middle of the views.
+void UnmapToReserved(void *address, size_t size) {
+	size = AlignUp(size, PAGE);
+	sceKernelMunmap(address, size);
+	if (!InReservation(address, size))
+		return;
+	void *addr = address;
+	const int32_t r = sceKernelReserveVirtualRange(&addr, size, MAP_FIXED_FLAG, PAGE);
+	if (r != 0 || addr != address)
+		ERROR_LOG(Log::MemMap, "PS4: re-reserving %p failed: %08x", address, r);
+}
+
+}  // namespace
+
+size_t MemArena::roundup(size_t x) {
+	return AlignUp(x, PAGE);
+}
+
+bool MemArena::NeedsProbing() {
+	return false;
+}
+
+bool MemArena::GrabMemSpace(size_t size) {
+	static bool aliasingTried = false;
+	if (!aliasingTried) {
+		// Mapping the same direct memory twice (the PSP's mirrors) fails with EBUSY until aliasing
+		// is enabled for the process.
+		aliasingTried = true;
+		const int32_t r1 = sceKernelEnableDmemAliasing();
+		const int32_t r2 = r1 == 0 ? 0 : sceKernelEnableDmemAliasing2();
+		INFO_LOG(Log::MemMap, "PS4: direct memory aliasing %08x, aliasing2 %08x", r1, r2);
+	}
+
+	g_dmemSize = AlignUp(size, LARGE_PAGE);
+	off_t physical = 0;
+	const int32_t r = sceKernelAllocateDirectMemory(0, (off_t)sceKernelGetDirectMemorySize(), g_dmemSize, LARGE_PAGE, WB_ONION, &physical);
+	if (r != 0) {
+		ERROR_LOG(Log::MemMap, "PS4: allocating %zu MiB of direct memory failed: %08x", g_dmemSize >> 20, r);
+		g_dmemSize = 0;
+		return false;
+	}
+	g_dmem = physical;
+	INFO_LOG(Log::MemMap, "PS4: %zu MiB of direct memory at %llx for the arena", g_dmemSize >> 20, (unsigned long long)g_dmem);
+	return true;
+}
+
+void MemArena::ReleaseSpace() {
+	if (g_reserved) {
+		sceKernelMunmap(g_reserved, g_reservedSize);
+		g_reserved = nullptr;
+		g_reservedSize = 0;
+	}
+	if (g_dmem >= 0) {
+		sceKernelReleaseDirectMemory(g_dmem, g_dmemSize);
+		g_dmem = -1;
+		g_dmemSize = 0;
+	}
+}
+
+void *MemArena::CreateView(s64 offset, size_t size, void *base) {
+	if (g_dmem < 0)
+		return nullptr;
+	size = AlignUp(size, PAGE);
+	if (base == nullptr) {
+		// Anywhere: let the kernel place it.
+		void *addr = nullptr;
+		const int32_t r = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, 0, g_dmem + offset, PAGE);
+		return r == 0 ? addr : nullptr;
+	}
+	// A fixed address in the reservation (or one a previous view left mapped).
+	sceKernelMunmap(base, size);
+	void *addr = base;
+	const bool large = (((uintptr_t)base | (uintptr_t)(g_dmem + offset) | size) & (LARGE_PAGE - 1)) == 0;
+	const int32_t r = sceKernelMapDirectMemory(&addr, size, PROT_CPU_RW, MAP_FIXED_FLAG, g_dmem + offset, large ? LARGE_PAGE : PAGE);
+	if (r != 0 || addr != base) {
+		ERROR_LOG(Log::MemMap, "PS4: mapping %zx bytes of the arena +%llx at %p failed: %08x", size, (unsigned long long)offset, base, r);
+		UnmapToReserved(base, size);
+		return nullptr;
+	}
+	return addr;
+}
+
+void MemArena::ReleaseView(s64 offset, void *view, size_t size) {
+	UnmapToReserved(view, size);
+}
+
+u8 *MemArena::Find4GBBase() {
+	if (g_reserved)
+		return g_reserved;
+	// Above the kernel's own allocations at 0x200000000 (DolphinPS4: they wrecked a heap there).
+	// A hint whose range isn't free fails (ENOMEM) instead of searching on: try a few, 4 GiB aligned.
+	for (uintptr_t hint : { 0x1000000000ull, 0x1800000000ull, 0x2400000000ull, 0x3000000000ull, 0x800000000ull }) {
+		void *base = (void *)hint;
+		const int32_t r = sceKernelReserveVirtualRange(&base, FOUR_GB, 0, LARGE_PAGE);
+		if (r == 0 && ((uintptr_t)base & (FOUR_GB - 1)) == 0) {
+			g_reserved = (u8 *)base;
+			g_reservedSize = FOUR_GB;
+			INFO_LOG(Log::MemMap, "PS4: 4 GiB of address space for the views at %p", base);
+			return g_reserved;
+		}
+		if (r == 0)
+			sceKernelMunmap(base, FOUR_GB);
+		WARN_LOG(Log::MemMap, "PS4: reserving 4 GiB at %p failed: %08x (got %p)", (void *)hint, r, base);
+	}
+	ERROR_LOG(Log::MemMap, "PS4: no 4 GiB of address space for the PSP memory views");
+	return nullptr;
+}
+
+#endif  // PPSSPP_PLATFORM(PS4)
