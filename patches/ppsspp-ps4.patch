+
+// M33: the startup clip (/data/March33/startup.mp4 if the user put one there, else the package's
+// /app0/assets/startup.mp4), played instead of the drawn opening when there is one.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+class UIContext;
+struct Bounds;
+
+namespace M33Clip {
+
+// Opens the clip and decodes its sound; false if there's none (or it can't be played).
+bool Open(const std::string &path);
+bool Active();
+// Its length in seconds (0 if the container doesn't say).
+float Duration();
+// Sound to play with it instead of its own (48 kHz interleaved stereo), before the first Draw.
+void SetSound(std::vector<int16_t> pcm);
+// Draws the picture for t seconds in (the sound starts with the first call).
+void Draw(UIContext &dc, const Bounds &bounds, double t);
+// Stops picture and sound, frees everything.
+void Close();
+
+}  // namespace M33Clip
