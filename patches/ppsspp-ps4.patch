+
+// M33: the in-game quick menu (L3 + R3), made for the controller after Crema's (CEMUPS4's
+// gui/ps4/PS4PauseMenu.cpp, itself after DolphinPS4's): the paused game behind a dark panel that
+// slides in from the left, its edge a glowing line; a header (M33, a pulsing tag, the game); rows
+// with drawn icons, a highlight that glides between them, values changed with Left / Right; the
+// clock and the buttons at the bottom. Crema draws it with ImGui; here it's PPSSPP's own UI drawing.
+//
+// What PPSSPP's pause screen does, on rows: save and load states (by slot), 60 FPS, cheats (a
+// page of their own), the rendering resolution, game volume and FPS counter (changed in place),
+// PPSSPP's full settings and the display layout & effects (its own screens), restart, exit.
+
+#include <algorithm>
+#include <cmath>
+#include <ctime>
+#include <string>
+
+#include "Common/Data/Text/I18n.h"
+#include "Common/File/Path.h"
+#include "Common/Input/InputState.h"
+#include "Common/Input/KeyCodes.h"
+#include "Common/File/FileUtil.h"
+#include "Common/GPU/thin3d.h"
+#include "Common/Render/DrawBuffer.h"
+#include "Common/Render/ManagedTexture.h"
+#include "Common/System/OSD.h"
+#include "Common/System/System.h"
+#include "Common/TimeUtil.h"
+#include "Common/UI/Context.h"
+#include "Common/StringUtils.h"
+#include "Common/UI/Root.h"
+#include "Common/UI/Screen.h"
+#include "Common/UI/ScreenManager.h"
