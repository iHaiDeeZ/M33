+#if PPSSPP_PLATFORM(PS4)
+	{
+		// RWX memory within reach of the eboot's code: the x86-64 JIT calls into it, and reads its
+		// globals, with 32-bit displacements. The kernel's mmap (the runtime's --wrap=mmap version
+		// moves big anonymous mappings far away, into the system pool). FreeBSD searches upwards
+		// from the hint.
+		const uintptr_t text = (uintptr_t)__text_start;
+		size = ppsspp_round_page(size);
+		for (uintptr_t hint = ppsspp_round_page(text + 0x4000000); hint < text + 0x60000000; hint += 0x4000000) {
+			void *p = __real_mmap((void *)hint, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_ANON | MAP_PRIVATE, -1, 0);
+			if (p == MAP_FAILED)
+				continue;
+			const intptr_t distance = (intptr_t)p - (intptr_t)text;
+			if (distance > -0x70000000LL && distance < 0x70000000LL)
+				return p;
+			munmap(p, size);
+		}
+		ERROR_LOG(Log::MemMap, "PS4: no RWX memory near the code for %d KiB of JIT code (errno %d)", (int)(size >> 10), errno);
+		return nullptr;
+	}
+#endif
