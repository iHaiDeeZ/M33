+bool System_MakeRequest(SystemRequestType type, int requestId, const std::string &param1, const std::string &param2, int64_t param3, int64_t param4) {
+	switch (type) {
+	case SystemRequestType::EXIT_APP:
+		g_quitRequested = true;
+		return true;
+	case SystemRequestType::RESTART_APP:
+		// No way to start ourselves again: quit, the user starts the app from the home screen.
+		g_restartRequested = true;
+		return true;
+	case SystemRequestType::INPUT_TEXT_MODAL:
+		// the PS4's keyboard; the text comes back through PS4Keyboard::Update
+		if (!PS4Keyboard::Open(requestId, param1, param2, param3 != 0))
+			g_requestManager.PostSystemFailure(requestId);
+		return true;
+	default:
+		// TODO: folder browsing.
+		return false;
+	}
+}
