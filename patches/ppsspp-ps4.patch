@@ -0,0 +1,286 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: the running game's cheats, as PPSSPP's cheat screen keeps them (UI/CwCheatScreen.cpp): one
+// file per game, PSP/Cheats/<game ID>.ini, each cheat's "_C1 name" (on) or "_C0 name" (off), its
+// codes imported from the CWCheat database (PSP/Cheats/cheat.db, the one PPSSPP downloads). The
+// cheat engine reads the file again when told to (bReloadCheats).
+//
+// 60 FPS: the database has "60 FPS" codes for many games (GTA Liberty City Stories, the God of
+// War games, LittleBigPlanet...), some per disc version ("60 FPS (USAv1)", "60 FPS (UMDv3.0)").
+// Turning it on imports the game's codes if they aren't in its file yet, picks the one for the
+// disc's version, turns it on and the game's other frame-rate codes off.
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <memory>
+
+#include "Common/File/FileUtil.h"
+#include "Common/File/Path.h"
+#include "Common/Log.h"
+#include "Common/Net/HTTPRequest.h"
+#include "Common/StringUtils.h"
+#include "Core/Config.h"
+#include "Core/ConfigValues.h"
+#include "Core/CwCheat.h"
+#include "Core/ELF/ParamSFO.h"
+#include "Core/System.h"
+#include "ps4/PS4Cheats.h"
+
+namespace M33Cheats {
+
+namespace {
+
+// The database PPSSPP's own list offers (metadata.ppsspp.org/cheats.json).
+constexpr char kDatabaseUrl[] = "https://raw.githubusercontent.com/Saramagrean/CWCheat-Database-Plus-/refs/heads/master/cheat.db";
+
+std::string g_gameID;
+std::unique_ptr<CWCheatEngine> g_engine;
+std::vector<CheatFileInfo> g_info;
+std::vector<Item> g_items;
+bool g_downloading = false;
+
+Path DatabasePath() {
+	return GetSysDirectory(DIRECTORY_CHEATS) / "cheat.db";
+}
+
+std::string GameID() {
+	std::string id = g_paramSFO.GetDiscID();
+	if (id.empty())
+		id = g_paramSFO.GenerateFakeID(PSP_CoreParameter().fileToStart);
+	return id;
+}
+
+std::vector<std::string> ReadLines(const Path &path) {
+	std::vector<std::string> lines;
+	std::string text;
+	if (!File::ReadTextFileToString(path, &text))
+		return lines;
+	size_t start = 0;
+	while (start <= text.size()) {
+		size_t end = text.find('\n', start);
+		if (end == std::string::npos)
+			end = text.size();
+		std::string line = text.substr(start, end - start);
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+		if (line.compare(0, 3, "\xEF\xBB\xBF") == 0) {
+			line.erase(0, 3);
+			if (line.empty()) {
+				start = end + 1;
+				continue;
+			}
+		}
+		if (end < text.size() || !line.empty())
+			lines.push_back(line);
+		start = end + 1;
+	}
+	return lines;
+}
+
+bool WriteLines(const Path &path, const std::vector<std::string> &lines) {
+	std::string text;
+	for (size_t i = 0; i < lines.size(); i++) {
+		text += lines[i];
+		if (i + 1 < lines.size())
+			text += '\n';
+	}
+	return File::WriteStringToFile(true, text, path);
+}
+
+void Reload() {
+	g_Config.bEnableCheats = true;
+	g_Config.bReloadCheats = true;
+}
+
+bool SetEnabled(const std::vector<std::pair<int, bool>> &changes) {
+	if (!g_engine)
+		return false;
+	std::vector<std::string> lines = ReadLines(g_engine->CheatFilename());
+	for (const auto &change : changes) {
+		const Item &item = g_items[change.first];
+		const CheatFileInfo &info = g_info[item.fileIndex];
+		const size_t index = (size_t)info.lineNum - 1;
+		if (index >= lines.size() || lines[index].find("_C") == std::string::npos || lines[index].find(info.name) == std::string::npos) {
+			WARN_LOG(Log::CwCheats, "M33: the cheat file changed under us, reading it again");
+			Load();
+			return false;
+		}
+		lines[index] = (change.second ? "_C1 " : "_C0 ") + info.name;
+	}
+	if (!WriteLines(g_engine->CheatFilename(), lines))
+		return false;
+	Reload();
+	Load();
+	return true;
+}
+
+}  // namespace
+
+bool Load() {
+	const std::string id = GameID();
+	if (id.empty())
+		return false;
+	if (!g_engine || id != g_gameID) {
+		g_gameID = id;
+		g_engine = std::make_unique<CWCheatEngine>(g_gameID);
+		g_engine->CreateCheatFile();
+	}
+	{
+		std::string raw;
+		if (File::ReadTextFileToString(g_engine->CheatFilename(), &raw)) {
+			std::vector<std::string> lines = ReadLines(g_engine->CheatFilename());
+			bool changed = raw.find("\xEF\xBB\xBF") != std::string::npos;
+			const Path done = GetSysDirectory(DIRECTORY_CHEATS) / ".m33-no60fps";
+			std::string doneList;
+			File::ReadTextFileToString(done, &doneList);
+			if (doneList.find(g_gameID) == std::string::npos) {
+				for (std::string &line : lines) {
+					if (line.compare(0, 4, "_C1 ") == 0 && (line.find("60 FPS") != std::string::npos || line.find("60 Fps") != std::string::npos)) {
+						line[2] = '0';
+						changed = true;
+					}
+				}
+				File::WriteStringToFile(true, doneList + g_gameID + "\n", done);
+			}
+			if (changed && WriteLines(g_engine->CheatFilename(), lines)) {
+				NOTICE_LOG(Log::CwCheats, "M33: %s's cheat file repaired", g_gameID.c_str());
+				g_Config.bReloadCheats = true;
+			}
+		}
+	}
+	g_info = g_engine->FileInfo();
+	g_items.clear();
+	for (size_t i = 0; i < g_info.size(); i++) {
+		std::string_view text;
+		if (g_info[i].IsPostComment(&text))
+			continue;  // (the database's notes under a cheat)
+		Item item;
+		item.fileIndex = (int)i;
+		if (g_info[i].IsTitle(&text)) {
+			item.header = true;
+			item.name = std::string(text);
+		} else {
+			item.name = g_info[i].name;
+			item.enabled = g_info[i].enabled;
+		}
+		g_items.push_back(item);
+	}
+	return true;
+}
+
+const std::vector<Item> &Items() {
+	return g_items;
+}
+
+int EnabledCount() {
+	int n = 0;
+	for (const Item &item : g_items)
+		n += !item.header && item.enabled;
+	return n;
+}
+
+bool Toggle(int item) {
+	if (item < 0 || item >= (int)g_items.size() || g_items[item].header)
+		return false;
+	return SetEnabled({ { item, !g_items[item].enabled } });
+}
+
+bool DatabaseExists() {
+	return File::Exists(DatabasePath());
+}
+
+bool Downloading() {
+	return g_downloading;
+}
+
+void DownloadDatabase(std::function<void(bool ok)> done) {
+	if (g_downloading)
+		return;
+	g_downloading = true;
+	File::CreateFullPath(GetSysDirectory(DIRECTORY_CHEATS));
+	const Path tmp = DatabasePath().WithExtraExtension(".part");
+	g_DownloadManager.StartDownload(kDatabaseUrl, tmp, http::RequestFlags::ProgressBar, nullptr, "m33cheatdb",
+		[tmp, done](http::Request &req) {
+			g_downloading = false;
+			const bool ok = req.ResultCode() == 200 && File::GetFileSize(tmp) > 1024 && File::Rename(tmp, DatabasePath());
+			if (!ok) {
+				ERROR_LOG(Log::CwCheats, "M33: cheat database download failed (HTTP %d)", req.ResultCode());
+				File::Delete(tmp);
+			} else {
+				NOTICE_LOG(Log::CwCheats, "M33: cheat database downloaded");
+			}
+			if (done)
+				done(ok);
+		});
+}
+
+int ImportFromDatabase() {
+	if (!g_engine || !DatabaseExists() || g_gameID.size() != 9)
+		return -1;
+	// The database names games "_S ULUS-10041"
+	const std::string wanted = "_S " + g_gameID.substr(0, 4) + "-" + g_gameID.substr(4);
+	std::vector<std::string> mine = ReadLines(g_engine->CheatFilename());
+	std::vector<std::string> names;
+	for (const CheatFileInfo &info : g_info)
+		names.push_back(info.name);
+	std::vector<std::string> header, added;
+	bool inGame = false, takeCheat = false;
+	// (read line by line: the database is ~9 MB)
+	FILE *in = File::OpenCFile(DatabasePath(), "rt");
+	if (!in)
+		return -1;
+	char buf[2048];
+	while (fgets(buf, sizeof(buf), in)) {
+		std::string line(buf);
+		while (!line.empty() && (line.back() == '\n' || line.back() == '\r'))
+			line.pop_back();
+		if (line.size() >= 2 && line[0] == '_' && line[1] == 'S') {
+			if (inGame)
+				break;  // only the first entry for the game
+			inGame = line == wanted;
+			if (inGame)
+				header.push_back(line);
+			continue;
+		}
+		if (!inGame)
+			continue;
+		if (line.size() >= 2 && line[0] == '_' && line[1] == 'G') {
+			header.push_back(line);
+		} else if (line.size() >= 2 && line[0] == '_' && line[1] == 'C') {
+			const std::string name = line.size() > 4 ? line.substr(4) : std::string();
+			takeCheat = std::find(names.begin(), names.end(), name) == names.end();
+			if (takeCheat)
+				added.push_back("_C0 " + name);  // in off, whatever the database says
+		} else if (takeCheat && ((line.size() >= 2 && line[0] == '_' && (line[1] == 'L' || line[1] == 'M')) || (!line.empty() && (line[0] == '#' || line[0] == '/')))) {
+			added.push_back(line);
+		}
+	}
+	fclose(in);
+	if (added.empty())
+		return 0;
+	const bool hasTitle = !mine.empty() && mine[0].size() >= 2 && mine[0][0] == '_' && mine[0][1] == 'S';
+	if (!hasTitle)
+		mine.insert(mine.begin(), header.begin(), header.end());
+	mine.insert(mine.end(), added.begin(), added.end());
+	if (!WriteLines(g_engine->CheatFilename(), mine))
+		return -1;
+	NOTICE_LOG(Log::CwCheats, "M33: %d lines from the cheat database for %s", (int)added.size(), g_gameID.c_str());
+	Reload();
+	Load();
+	return (int)added.size();
+}
+
+}  // namespace M33Cheats
