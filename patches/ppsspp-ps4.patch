+// Makes (or removes) the memory stick stand-ins for the discs in gamesDir. Before the XMB boots.
+void M33Xmb_PrepareGames(const Path &gamesDir);
+
+// A disc started from M33's own list goes through the firmware, as a PSP powered on with the disc
+// in: its startup, then its own game boot, then the firmware launches the disc, and M33 boots it as
+// itself (EmuScreen, sceKernelLoadExec, sceReg's umd_autoboot).
+// The disc of the firmware boot under way (empty when there's none).
+const std::string &M33Fw_Disc();
+void M33Fw_SetDisc(const std::string &disc);
+// The disc the firmware (or the XMB) launched: its next boot goes straight in. True once for it.
+void M33Fw_SetDirect(const std::string &disc);
+bool M33Fw_TakeDirect(const std::string &disc);
diff --git a/ps4/ps4.cmake b/ps4/ps4.cmake
new file mode 100644
index 0000000..407ae6f
--- /dev/null
+++ b/ps4/ps4.cmake
@@ -0,0 +1,57 @@
+# M33: PPSSPP's PS4 frontend, included from the top CMakeLists.txt once ${TargetBin} exists.
+# Built with M33's toolchain (toolchain/ps4-m33.cmake, and ps4-love-style.cmake as the project
+# include: PS4_RUNTIME_SOURCES, ps4_link_mesa, ps4_add_eboot).
+
+target_sources(${TargetBin} PRIVATE
+	ps4/PS4Main.cpp
+	ps4/PS4Audio.cpp
+	ps4/PS4Audio.h
+	ps4/PS4Brand.cpp
+	ps4/PS4Brand.h
+	ps4/PS4Keyboard.cpp
+	ps4/PS4Keyboard.h
+	ps4/PS4Cheats.cpp
+	ps4/PS4Cheats.h
+	ps4/PS4Pad.cpp
+	ps4/PS4TextDrawer.cpp
+	ps4/PS4Lang.cpp
+	ps4/PS4QuickMenu.cpp
+	ps4/PS4QuickMenu.h
+	ps4/PS4Rewind.cpp
+	ps4/PS4Rewind.h
+	ps4/PS4Pad.h
+	ps4/PS4StartupClip.cpp
+	ps4/PS4StartupClip.h
+	ps4/PS4Stubs.c
+	ps4/PS4VulkanWSI.cpp
+	ps4/PS4VulkanWSI.h
+	ps4/PS4XmbGames.cpp
+	ps4/PS4XmbGames.h
+	${PS4_RUNTIME_SOURCES})
+
+# FreeBSD kernel without sockets for local IPC or serial ports
+target_compile_definitions(${TargetBin} PRIVATE ASIO_DISABLE_LOCAL_SOCKETS ASIO_DISABLE_SERIAL_PORT ASIO_DISABLE_KQUEUE)
+
+# The network library's shares (port/ps4_netfs.cpp: SMB and NFS under /net)
+target_link_libraries(${TargetBin} ${PS4_SYSROOT}/lib/libnfs.a ${PS4_SYSROOT}/lib/libsmb2.a)
+
+# HTTPS (RetroAchievements, downloads): naett's curl backend on the sysroot's static curl + OpenSSL
+target_link_libraries(${TargetBin} ${PS4_SYSROOT}/lib/libcurl.a ${PS4_SYSROOT}/lib/libssl.a ${PS4_SYSROOT}/lib/libcrypto.a ${PS4_SYSROOT}/lib/libz.a)
+
+# Text in every language (ps4/PS4TextDrawer.cpp): PPSSPP's own FreeType
+target_include_directories(${TargetBin} PRIVATE ${CMAKE_SOURCE_DIR}/ext/freetype/include)
+target_link_libraries(${TargetBin} freetype)
+# and HarfBuzz to shape it (joined Arabic letters, right to left, Thai/Khmer/Lao marks), one file
+add_library(m33harfbuzz STATIC ${CMAKE_SOURCE_DIR}/ext/harfbuzz/src/harfbuzz.cc)
+target_compile_definitions(m33harfbuzz PRIVATE HAVE_FREETYPE=1 HB_NO_MT)
+target_include_directories(m33harfbuzz PRIVATE ${CMAKE_SOURCE_DIR}/ext/freetype/include)
+target_compile_options(m33harfbuzz PRIVATE -fno-exceptions -fno-rtti -w)
+target_link_libraries(m33harfbuzz freetype)
+target_include_directories(${TargetBin} PRIVATE ${CMAKE_SOURCE_DIR}/ext/harfbuzz/src)
+target_link_libraries(${TargetBin} m33harfbuzz)
+
+# RADV on GNM, the system libraries, and eboot.bin
+ps4_link_mesa(${TargetBin})
+target_link_libraries(${TargetBin}
+	SceSysmodule SceSystemService SceUserService SceVideoOut SceAudioOut ScePad SceNet SceCommonDialog SceImeDialog)
+ps4_add_eboot(${TargetBin})
