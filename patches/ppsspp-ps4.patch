+#if PPSSPP_PLATFORM(PS4)
+// Sony's PSP system update 6.61, from its update server (plain HTTP; the folder name is the file's
+// MD5). Downloaded once to <memstick>/firmware, then installed with PPSSPP's own installer.
+static const char *const kSonyFirmwareUrl =
+	"http://du01.psp.update.playstation.org/update/psp/image/us/2014_1212_6be8878f475ac5b1a499b95ab2f7d301/EBOOT.PBP";
+static const u64 kSonyFirmwareSize = 32580549;
+
+// Sony's update server by the console's DNS, or else by public DNS servers asked directly: a
+// jailbroken console's DNS often blocks Sony's domains (against system updates).
+static std::string ResolvePastBlockingDNS(const std::string &host) {
+	addrinfo *res = nullptr;
+	std::string error;
+	if (net::DNSResolve(host, "80", &res, error)) {
+		net::DNSResolveFree(res);
+		return host;
+	}
+	for (const char *dns : { "1.1.1.1", "8.8.8.8" }) {
+		uint32_t address = 0;
+		if (net::DirectDNSLookupIPV4(dns, host.c_str(), &address)) {
+			char ip[32];
+			inet_ntop(AF_INET, &address, ip, sizeof(ip));
+			NOTICE_LOG(Log::Loader, "%s by %s: %s (the console's DNS didn't answer)", host.c_str(), dns, ip);
+			return ip;
+		}
+	}
+	return host;
+}
+
+void FirmwareScreen::DownloadFromSony() {
+	auto sy = GetI18NCategory(I18NCat::SYSTEM);
+	const Path dir = GetSysDirectory(DIRECTORY_MEMSTICK_ROOT) / "firmware";
+	const Path file = dir / "PSP661_EBOOT.PBP";
+	ScreenManager *sm = screenManager();
+	auto install = [sm, file]() {
+		sm->push(new InstallUpdateScreen(file, "PSP 6.61", false, kSonyFirmwareSize));
+	};
+	if (File::GetFileSize(file) == kSonyFirmwareSize) {
+		install();
+		return;
+	}
+	File::CreateFullPath(dir);
+	File::Delete(file);
+	g_OSD.Show(OSDType::MESSAGE_INFO, sy->T("Downloading PSP firmware 6.61 from Sony..."), 3.0f, "m33fw");
+	g_DownloadManager.StartDownloadResolved(kSonyFirmwareUrl, file, http::RequestFlags::ProgressBar, &ResolvePastBlockingDNS, "psp661",
+		[install, file](http::Request &req) {
+			auto sy = GetI18NCategory(I18NCat::SYSTEM);
+			if (req.ResultCode() == 200 && File::GetFileSize(file) == kSonyFirmwareSize) {
+				install();
+			} else {
+				ERROR_LOG(Log::Loader, "PSP firmware download failed: HTTP %d, %lld bytes", req.ResultCode(), (long long)File::GetFileSize(file));
+				File::Delete(file);
+				g_OSD.Show(OSDType::MESSAGE_ERROR, sy->T("Couldn't download the PSP firmware. Check the console's internet connection."),
+					ApplySafeSubstitutions(sy->T("M33FirmwareByHand", "Or copy Sony's 6.61 update (EBOOT.PBP) to %1 and press this again"), file.ToVisualString()),
+					10.0f, "m33fw");
+			}
+		});
+}
