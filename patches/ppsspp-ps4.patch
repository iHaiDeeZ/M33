+int CurrentLang() {
+	const std::string &l = g_Config.sLanguageIni;  // es_ES, pt_BR, zh_CN, zh_TW, ...
+	static const struct { const char *prefix; int lang; } kMap[] = {
+		{ "es", ES }, { "fr", FR }, { "de", DE }, { "it", IT }, { "pt", PT }, { "nl", NL }, { "pl", PL },
+		{ "tr", TR }, { "ru", RU }, { "ja", JA }, { "zh_TW", TW }, { "zh_HK", TW }, { "zh", ZH }, { "ko", KO },
+	};
+	for (const auto &m : kMap)
+		if (startsWith(l, m.prefix))
+			return m.lang;
+	return -1;
+}
+
+}  // namespace
+
+const char *M33T(const char *english) {
+	const int lang = CurrentLang();
+	if (lang < 0)
+		return english;
+	for (const Row &row : kRows)
+		if (strcmp(row.en, english) == 0)
+			return row.t[lang];
+	return english;
+}
