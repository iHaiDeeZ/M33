diff --git a/ps4/PS4XmbGames.cpp b/ps4/PS4XmbGames.cpp
new file mode 100644
index 0000000..0d469bd
--- /dev/null
+++ b/ps4/PS4XmbGames.cpp
@@ -0,0 +1,188 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: the user's disc games in the XMB's Game column, as CFW ISO drivers had them.
+//
+// The XMB lists the memory stick's PSP/GAME folders that hold an EBOOT.PBP, and reads only the
+// PBP's PARAM.SFO, ICON0.PNG and PIC1.PNG to show them. So before it boots, every ISO / CSO / CHD in
+// the games folder gets a stand-in, PSP/GAME/M33ISO_<disc id>/EBOOT.PBP, made of those three files
+// from the disc (the category made a memory stick game's), next to M33ISO.TXT naming the disc.
+// When the XMB launches one, sceKernelLoadExec (Core/HLE/sceKernelModule.cpp) finds M33ISO.TXT
+// and boots the disc instead. The game browser hides the stand-ins (UI/GameBrowser.cpp).
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "Common/File/DirListing.h"
+#include "Common/File/FileUtil.h"
+#include "Common/File/Path.h"
+#include "Common/Log.h"
+#include "Common/StringUtils.h"
+#include "Core/ELF/ParamSFO.h"
+#include "Core/FileSystems/BlockDevices.h"
+#include "Core/FileSystems/FileSystem.h"
+#include "Core/FileSystems/ISOFileSystem.h"
+#include "Core/Loaders.h"
+#include "Core/Util/PathUtil.h"
+#include "ps4/PS4XmbGames.h"
+
+namespace {
+
+constexpr const char *kPrefix = "M33ISO_";
+constexpr const char *kMarker = "M33ISO.TXT";
+
+bool ReadIsoFile(ISOFileSystem &fs, const char *name, std::string *out) {
+	PSPFileInfo info = fs.GetFileInfo(name);
+	if (!info.exists || info.size <= 0 || info.size > 16 * 1024 * 1024)
+		return false;
+	const int handle = fs.OpenFile(name, FILEACCESS_READ);
+	if (handle < 0)
+		return false;
+	out->resize((size_t)info.size);
+	const size_t got = fs.ReadFile(handle, (u8 *)&(*out)[0], info.size);
+	fs.CloseFile(handle);
+	out->resize(got);
+	return got > 0;
+}
+
+void Put32(std::string *s, size_t at, u32 v) {
+	memcpy(&(*s)[at], &v, 4);
+}
+
+// A PBP: PARAM.SFO, ICON0.PNG, ICON1.PMF, PIC0.PNG, PIC1.PNG, SND0.AT3, DATA.PSP, DATA.PSAR.
+std::string MakePBP(const std::string &sfo, const std::string &icon0, const std::string &pic1) {
+	const std::string *parts[8] = { &sfo, &icon0, nullptr, nullptr, &pic1, nullptr, nullptr, nullptr };
+	std::string pbp(0x28, '\0');
+	pbp[1] = 'P'; pbp[2] = 'B'; pbp[3] = 'P';
+	Put32(&pbp, 4, 0x00010000);
+	for (int i = 0; i < 8; i++) {
+		Put32(&pbp, 8 + i * 4, (u32)pbp.size());
+		if (parts[i])
+			pbp += *parts[i];
+	}
+	return pbp;
+}
+
+std::string SafeId(const std::string &id) {
+	std::string out;
+	for (char c : id)
+		out += isalnum((unsigned char)c) ? c : '_';
+	return out.empty() ? "UNKNOWN" : out;
+}
+
+// One disc's stand-in; false if the disc can't be read as a PSP game.
+bool MakeStandIn(const Path &disc, const Path &gameDir) {
+	std::unique_ptr<FileLoader> loader(ConstructFileLoader(disc));
+	if (!loader || !loader->Exists())
+		return false;
+	std::string error;
+	std::shared_ptr<BlockDevice> bd(ConstructBlockDevice(loader.get(), &error));
+	if (!bd)
+		return false;
+	SequentialHandleAllocator handles;
+	ISOFileSystem umd(&handles, bd);
+	std::string sfoData, icon0, pic1;
+	if (!ReadIsoFile(umd, "/PSP_GAME/PARAM.SFO", &sfoData))
+		return false;
+	ReadIsoFile(umd, "/PSP_GAME/ICON0.PNG", &icon0);
+	ReadIsoFile(umd, "/PSP_GAME/PIC1.PNG", &pic1);
+
+	ParamSFOData sfo;
+	if (!sfo.ReadSFO((const u8 *)sfoData.data(), sfoData.size()))
+		return false;
+	const std::string discId = sfo.GetValueString("DISC_ID");
+	// a memory stick game in the XMB's eyes
+	sfo.SetValue("CATEGORY", "MG", 4);
+	u8 *newSfo = nullptr;
+	size_t newSize = 0;
+	sfo.WriteSFO(&newSfo, &newSize);
+	const std::string sfoOut((const char *)newSfo, newSize);
+	delete[] newSfo;
+
+	const Path dir = gameDir / (std::string(kPrefix) + SafeId(discId));
+	File::CreateFullPath(dir);
+	const std::string pbp = MakePBP(sfoOut, icon0, pic1);
+	const std::string marker = disc.ToString();
+	return File::WriteDataToFile(false, pbp.data(), pbp.size(), dir / "EBOOT.PBP") &&
+		File::WriteDataToFile(false, marker.data(), marker.size(), dir / kMarker);
+}
+
+}  // namespace
+
+void M33Xmb_PrepareGames(const Path &gamesDir) {
+	const Path gameDir = GetSysDirectory(DIRECTORY_GAME);
+	File::CreateFullPath(gameDir);
+
+	// The stand-ins already there, and the discs they stand for.
+	std::vector<File::FileInfo> existing;
+	File::GetFilesInDir(gameDir, &existing, nullptr, File::GETFILES_GETHIDDEN);
+	std::vector<std::string> covered;
+	for (const File::FileInfo &f : existing) {
+		if (!f.isDirectory || !startsWith(f.name, kPrefix))
+			continue;
+		std::string disc;
+		File::ReadTextFileToString(f.fullName / kMarker, &disc);
+		if (disc.empty() || !File::Exists(Path(disc)) || !File::Exists(f.fullName / "EBOOT.PBP")) {
+			// the disc is gone (or the stand-in is incomplete): remove it
+			File::DeleteDirRecursively(f.fullName);
+			continue;
+		}
+		covered.push_back(disc);
+	}
+
+	std::vector<File::FileInfo> discs;
+	File::GetFilesInDir(gamesDir, &discs, nullptr, 0);
+	int made = 0;
+	for (const File::FileInfo &f : discs) {
+		if (f.isDirectory)
+			continue;
+		const std::string ext = f.fullName.GetFileExtension();
+		if (ext != ".iso" && ext != ".cso" && ext != ".chd")
+			continue;
+		bool known = false;
+		for (const std::string &c : covered)
+			known |= c == f.fullName.ToString();
+		if (known)
+			continue;
+		if (MakeStandIn(f.fullName, gameDir))
+			made++;
+		else
+			WARN_LOG(Log::Loader, "XMB: %s isn't a PSP game disc, not listed", f.fullName.c_str());
+	}
+	INFO_LOG(Log::Loader, "XMB: %d discs listed (%d new)", (int)covered.size() + made, made);
+}
+
+namespace {
+std::string g_fwDisc;
+std::string g_direct;
+}  // namespace
+
+const std::string &M33Fw_Disc() {
+	return g_fwDisc;
+}
+
+void M33Fw_SetDisc(const std::string &disc) {
+	g_fwDisc = disc;
+}
+
+void M33Fw_SetDirect(const std::string &disc) {
+	g_direct = disc;
+}
+
+bool M33Fw_TakeDirect(const std::string &disc) {
+	const bool direct = !g_direct.empty() && g_direct == disc;
+	g_direct.clear();
+	return direct;
+}
