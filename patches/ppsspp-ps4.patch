+// If not, see http://www.gnu.org/licenses/
+
+// M33 (March33): PPSSPP's PS4 frontend.
+//
+//   /app0                    the package: eboot.bin, version.txt, assets/ (PPSSPP's assets)
+//   /data/March33            the memory stick (PSP/GAME, PSP/SAVEDATA, PSP/SYSTEM/ppsspp.ini, ...),
+//                            ppsspp.log, boot-trace.log, crash.log, hang.log
+//   /data/March33/games      games (ISO, CSO, CHD, PBP, ...), where the game browser starts
+//
+// PPSSPP's own UI is the frontend: it is controller friendly, and the device type is a TV. Video
+// is Vulkan on Mesa's RADV for GNM (ps4/PS4VulkanWSI.cpp presents through VideoOut), audio is
+// sceAudioOut (ps4/PS4Audio.cpp), input is ScePad (ps4/PS4Pad.cpp). The emulator (and the
+// rendering it submits) runs on its own thread, the main thread polls the pads.
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "ppsspp_config.h"
+#include "Common/File/FileUtil.h"
+#include "Common/File/Path.h"
+#include "Common/GPU/Vulkan/VulkanContext.h"
+#include "Common/GPU/Vulkan/VulkanGraphicsContext.h"
+#include "Common/Log.h"
+#include "Common/Log/LogManager.h"
+#include "Common/StringUtils.h"
+#include "Common/System/Display.h"
+#include "Common/System/NativeApp.h"
+#include "Common/System/Request.h"
+#include "Common/System/System.h"
+#include "Common/Thread/ThreadUtil.h"
+#include "Common/TimeUtil.h"
+#include "Core/CmdLine.h"
+#include "Core/Config.h"
+#include "Core/ConfigValues.h"
+#include "Core/Core.h"
+#include "Core/EmuThread.h"
+#include "Core/MIPS/MIPS.h"
+#include "ps4/PS4Audio.h"
+#include "ps4/PS4Pad.h"
+#include "ps4/PS4VulkanWSI.h"
+
+// After PPSSPP's headers: libkernel's headers have an enumerator named SystemNotification, which
+// hides PPSSPP's enum of that name from here on (System_Notify below says "enum SystemNotification").
+#include <orbis/Sysmodule.h>
+#include <orbis/SystemService.h>
+#include <orbis/UserService.h>
+#include <orbis/Pad.h>
+
+extern "C" void ps4_boot_trace(const char *line);  // port/ps4_crashlog.cpp
+extern "C" void ps4_sampler_start();                // port/ps4_sampler.cpp
+
+// L1 held while the app starts: no XMB this time, even with Start in the XMB on (UI/NativeApp.cpp).
+bool m33_skip_xmb = false;
+
+namespace {
+
+const char *const kDataRoot = "/data/March33";
+const char *const kGamesDir = "/data/March33/games";
+
+std::atomic<bool> g_quitRequested{ false };
+std::atomic<bool> g_restartRequested{ false };
+
+void Trace(const std::string &line) {
+	ps4_boot_trace(line.c_str());
+}
+
+void LoadSystemModules() {
+	// Calling into a system library whose module isn't loaded kills the app silently.
+	const std::pair<const char *, uint32_t> modules[] = {
+		{ "SystemService", 0x80000010 }, { "UserService", 0x80000011 }, { "VideoOut", 0x80000022 },
+		{ "AudioOut", 0x80000001 }, { "Pad", 0x80000024 }, { "Net", 0x8000001C },
+	};
+	for (const auto &[name, id] : modules) {
+		const int result = (int)sceSysmoduleLoadModuleInternal((OrbisSysModuleInternal)id);
+		if (result != 0) {
+			char line[96];
+			snprintf(line, sizeof(line), "loading system module %s failed (%x)", name, (uint32_t)result);
+			Trace(line);
+		}
+	}
+}
+
+std::string AppVersion() {
+	FILE *f = fopen("/app0/version.txt", "r");
+	if (!f)
+		return "?";
+	char buf[32]{};
+	if (!fgets(buf, sizeof(buf), f))
+		buf[0] = '\0';
+	fclose(f);
+	std::string v(buf);
+	while (!v.empty() && (v.back() == '\n' || v.back() == '\r' || v.back() == ' '))
+		v.pop_back();
+	return v;
+}
+
+// The console's system language as a PPSSPP language ini name.
+std::string ConsoleLanguage() {
+	static const char *const kLanguages[] = {
+		"ja_JP", "en_US", "fr_FR", "es_ES", "de_DE", "it_IT", "nl_NL", "pt_PT", "ru_RU", "ko_KR",
+		"zh_TW", "zh_CN", "fi_FI", "sv_SE", "da_DK", "no_NO", "pl_PL", "pt_BR", "en_US", "tr_TR",
+		"es_LA", "ar_AE", "fr_FR", "cz_CZ", "hu_HU", "gr_EL", "ro_RO", "th_TH", "vi_VN", "id_ID",
+	};
+	int32_t lang = 1;
+	if (sceSystemServiceParamGetInt(ORBIS_SYSTEM_SERVICE_PARAM_ID_LANG, &lang) != 0)
+		lang = 1;
+	if (lang < 0 || lang >= (int32_t)ARRAY_SIZE(kLanguages))
+		return "en_US";
+	return kLanguages[lang];
+}
+
+// Whether the first user is holding L1 right now (read once, before the pads are set up).
+bool L1HeldAtLaunch() {
+	int32_t user = -1;
+	if (sceUserServiceGetInitialUser(&user) != 0 || user < 0)
+		return false;
+	scePadInit();
+	const int handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+	if (handle < 0)
+		return false;
+	OrbisPadData data{};
+	const bool held = scePadReadState(handle, &data) == 0 && data.connected && (data.buttons & ORBIS_PAD_BUTTON_L1);
+	scePadClose(handle);
+	return held;
+}
+
+}  // namespace
+
+int main(int argc, char *argv[]) {
+	LoadSystemModules();
+	Trace("M33 " + AppVersion() + " starting (PPSSPP " + std::string(PPSSPP_GIT_VERSION) + ")");
+	mkdir(kDataRoot, 0777);
+	mkdir(kGamesDir, 0777);
+	if (access((std::string(kDataRoot) + "/profile.txt").c_str(), F_OK) == 0)
+		ps4_sampler_start();
+
+	sceUserServiceInitialize(nullptr);
+	m33_skip_xmb = L1HeldAtLaunch();
+	if (m33_skip_xmb)
+		Trace("L1 held: not starting in the XMB");
+	TimeInit();
+
+	// No command line on the console (argv[0] is the eboot).
+	CommandLineOptions cmdLineOptions;
+	cmdLineOptions.fullscreen = true;
+
+	g_display.pixel_xres = ps4wsi::kWidth;
+	g_display.pixel_yres = ps4wsi::kHeight;
+	g_Config.bFullScreen = true;
+
+	const std::string dataDir = std::string(kDataRoot) + "/";
+	Trace("NativeInit");
+	NativeInit(argc, (const char **)argv, cmdLineOptions, dataDir.c_str(), kGamesDir, nullptr);
+	g_logManager.SetFileLogPath(Path(kDataRoot) / "ppsspp.log");
+	g_logManager.EnableOutput(LogOutput::File);
+
+	// Vulkan is the only backend here.
+	g_Config.iGPUBackend = (int)GPUBackend::VULKAN;
+	g_Config.bFullScreen = true;
+	if (g_Config.sLanguageIni.empty())
+		g_Config.sLanguageIni = ConsoleLanguage();
+	Native_UpdateScreenScale(ps4wsi::kWidth, ps4wsi::kHeight, UIScaleFactorToMultiplier(g_Config.iUIScaleFactor));
+
+	Trace("graphics");
+	auto *graphicsContext = new VulkanGraphicsContext();
+	std::string error;
+	if (!graphicsContext->InitAPI(nullptr, &g_Config.sVulkanDevice, &error)) {
+		Trace("Vulkan initialization failed: " + error);
+		return 1;
+	}
+	VulkanContext *vulkan = (VulkanContext *)graphicsContext->GetAPIContext();
+	vulkan->SetCbGetDrawSize([]() { return VkExtent2D{ ps4wsi::kWidth, ps4wsi::kHeight }; });
+	if (!graphicsContext->InitSurface(WINDOWSYSTEM_HEADLESS, nullptr, nullptr, &error)) {
+		Trace("Vulkan surface creation failed: " + error);
+		return 1;
+	}
+	g_Config.sFailedGPUBackends.clear();
+
+	PS4Audio::Start();
+	PS4Pad::Init();
+
+	Trace("main loop");
+	std::thread emuThread([&] {
+		SetCurrentThreadName("EmuThread");
+		RunMainLoop(graphicsContext, new NativeApplication(), [&](GraphicsContext *ctx) {
+			NativeFrame(ctx);
+			return !(g_quitRequested || g_restartRequested);
+		});
+	});
+
+	// The main thread polls the pads, about 240 times a second.
+	while (!(g_quitRequested || g_restartRequested)) {
+		PS4Pad::Poll();
+		std::this_thread::sleep_for(std::chrono::microseconds(4000));
+	}
+	Trace("exiting");
+	emuThread.join();
+
+	PS4Pad::Shutdown();
+	PS4Audio::Stop();
+	graphicsContext->ShutdownSurface();
+	graphicsContext->ShutdownAPI();
+	delete graphicsContext;
+	NativeShutdown();
+	Trace("exited");
+	return 0;
+}
+
+// The emulator's view of a crash (port/ps4_crashlog.cpp calls it after the host stacks): the
+// PSP CPU's registers, appended to crash.log. No allocation, no locks.
+extern "C" void ps4_crash_guest_info() {
+	if (!currentMIPS)
+		return;
+	const int fd = open("/data/March33/crash.log", O_WRONLY | O_CREAT | O_APPEND, 0666);
+	if (fd < 0)
+		return;
+	char line[160];
+	int n = snprintf(line, sizeof(line), "\n== PSP CPU at the crash: pc %08x ra %08x hi %08x lo %08x\n",
+		currentMIPS->pc, currentMIPS->r[MIPS_REG_RA], currentMIPS->hi, currentMIPS->lo);
+	write(fd, line, n);
+	for (int i = 0; i < 32; i += 4) {
+		n = snprintf(line, sizeof(line), "r%-2d %08x  r%-2d %08x  r%-2d %08x  r%-2d %08x\n",
+			i, currentMIPS->r[i], i + 1, currentMIPS->r[i + 1], i + 2, currentMIPS->r[i + 2], i + 3, currentMIPS->r[i + 3]);
+		write(fd, line, n);
+	}
+	close(fd);
+}
+
+// --- PPSSPP's platform interface (Common/System/System.h, NativeApp.h) ---
+
