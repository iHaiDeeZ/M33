--- /dev/null
+++ b/ps4/PS4Rewind.cpp
@@ -0,0 +1,652 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: RetroArch-style rewind. Hold L2 and the game plays backwards; let go and it carries on
+// from there.
+//
+// While playing, two things are recorded:
+// - snapshots of the emulator, every kSnapInterval frames. As in RetroArch's state manager, only
+//   the newest is kept whole; each older one as its difference to the one after it (the 2 KB blocks
+//   that changed, zstd-compressed).
+// - the picture on the screen, every kPicInterval frames (at the PSP's 480x272, RGB565, zstd),
+//   each tagged with the snapshot it came after.
+// Holding L2 pauses the emulator and plays the pictures backwards, smoothly, at 1x speeding up to
+// 3x the longer it's held; the snapshots are walked back along with them (cheap: only differences
+// are applied, nothing is loaded). Letting go loads the snapshot of the picture shown, once, and the
+// game carries on from there; holding L2 again rewinds further, as far as is recorded.
+// (PPSSPP's own rewind keeps 20 whole-ish states seconds apart and jumps back one per press. M33's
+// first try loaded a snapshot every frame going back: ~45 ms each, and a 30 fps game drew nothing
+// in the one frame that ran after it, so nothing new was seen.)
+//
+// All of it lives in one block of direct memory, mapped once: the whole snapshots, the compression
+// buffers (fixed), and the history (an allocator of its own, oldest dropped first when it's full).
+// Nothing goes through the app heap: 40 MB snapshot buffers reallocated there fragmented it into a
+// bad_alloc crash (v00.18).
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <deque>
+#include <string>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+#include <zstd.h>
+
+#include "Common/Data/Text/I18n.h"
+#include "Common/GPU/thin3d.h"
+#include "Common/Render/DrawBuffer.h"
+#include "Common/Log.h"
+#include "Common/System/OSD.h"
+#include "Common/Thread/ThreadUtil.h"
+#include "Common/TimeUtil.h"
+#include "Common/UI/Context.h"
+#include "Core/Config.h"
+#include "Core/RetroAchievements.h"
+#include "Core/HW/Display.h"
+#include "Core/SaveState.h"
+#include "Core/Screenshot.h"
+#include "GPU/Common/GPUDebugInterface.h"
+#include "GPU/GPUCommon.h"
+#include "ps4/PS4Rewind.h"
+
+extern "C" {
+// Declared by hand, as in Common/MemArenaPS4.cpp (several OpenOrbis prototypes are wrong).
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t searchStart, off_t searchEnd, size_t length, size_t alignment,
+		int32_t memoryType, off_t *physicalOut);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int32_t protection, int32_t flags,
+		off_t directMemoryStart, size_t alignment);
+// port/ps4_dlmalloc.c (the app heap's allocator), here over the rewind's own memory.
+void *create_mspace_with_base(void *base, size_t capacity, int locked);
+void *mspace_malloc(void *msp, size_t bytes);
+void mspace_free(void *msp, void *mem);
+}
+
+namespace {
+
+constexpr int kSnapInterval = 10;  // frames between snapshots (6 a second; the pictures are 30)
+constexpr int kSnapMaxFrames = 30;  // ...put off to a frame with room, at most this long
+double g_lastFrameAt = 0.0;
+int g_slowFrames = 0, g_slowAfterSnapshot = 0;
+bool g_lastWasSnapshot = false;
+constexpr int kPicInterval = 2;   // frames between pictures (30 a second: every frame of a 30 fps game)
+constexpr double kPicsPerSecond = 60.0 / kPicInterval;
+constexpr size_t kBlock = 2048;
+constexpr size_t MB = 1024 * 1024;
+constexpr size_t LARGE_PAGE = 0x200000;
+// A whole snapshot: the PSP's RAM (up to 64 MB) and VRAM, and the rest of its state.
+constexpr size_t kSnapshotCap = 80 * MB;
+constexpr int kPicW = 480, kPicH = 272;
+constexpr size_t kPicRaw = kPicW * kPicH * 2;  // RGB565
+constexpr size_t kPicCap = 512 * 1024;         // a compressed picture, at most (ZSTD_compressBound)
+constexpr size_t kFixed = 3 * kSnapshotCap + kPicRaw + kPicCap + 3 * kPicW * kPicH * 4;
+
+struct Buffer {
+	u8 *data = nullptr;
+	size_t size = 0;
+};
+
+struct Delta {
+	void *data;
+	u32 size;     // compressed
+	u32 rawSize;  // uncompressed
+};
+
+struct Pic {
+	void *data;
+	u32 size;
+	u32 tag;  // the snapshot it came after
+};
+
+bool g_initTried = false;
+bool g_ready = false;
+void *g_space = nullptr;     // the history's allocator
+std::deque<Delta> g_deltas;  // oldest first; the last turns snapshot g_curId into g_curId - 1
+std::deque<Pic> g_pics;      // oldest first
+
+Buffer g_cur;   // the newest snapshot, whole (going back: the one of the picture shown)
+Buffer g_next;  // the one being taken (going back: a scratch buffer)
+u32 g_curId = 0;
+bool g_haveCur = false;
+u8 *g_zout = nullptr;     // a difference's compression output, kSnapshotCap
+u8 *g_picRaw = nullptr;   // a picture as RGB565
+u8 *g_picZ = nullptr;     // a picture compressed
+u8 *g_picRgba = nullptr;  // the picture shown, for its texture
+u8 *g_picRead = nullptr;  // a picture read back from the GPU
+// The picture worker: a read-back picture (g_picIn) to RGB565 (g_picRaw) and zstd (g_picZ), off the
+// emulation thread (it cost ~3 ms there, 30 times a second: too much at 60 FPS).
+u8 *g_picIn = nullptr;
+std::thread g_picThread;
+std::mutex g_picLock;
+std::condition_variable g_picCv;
+bool g_picPending = false, g_picDone = false;
+size_t g_picOutSize = 0;
+u32 g_picTag = 0;
+Draw::Framebuffer *g_picFbo = nullptr;  // the displayed picture, at 480x272
+int g_picReadValid = 0;  // (the first late readback has nothing in it yet)
+
+std::thread g_worker;
+bool g_pending = false;  // a difference compressed in g_zout, to keep once the worker is done
+size_t g_pendingSize = 0, g_pendingRaw = 0;
+bool g_pendingOk = false;
+ZSTD_CCtx *g_cctx = nullptr;   // the worker's
+ZSTD_CCtx *g_pcctx = nullptr;  // the pictures'
+ZSTD_DCtx *g_dctx = nullptr;
+
+int g_snapFrames = 0, g_picFrames = 0;
+bool g_rewinding = false;
+std::atomic<bool> g_active{ false };
+double g_heldSince = 0.0, g_lastStep = 0.0, g_owed = 0.0;
+int g_shown = -1;  // index in g_pics of the picture shown going back
+int g_steps = 0;
+bool g_endShown = false;
+Draw::Texture *g_tex = nullptr;
+bool g_texDirty = false;
+
+double g_snapMs = 0.0, g_picMs = 0.0;
+int g_snaps = 0, g_picsTaken = 0;
+
+void PictureWorker() {
+	SetCurrentThreadName("M33RewindPics");
+	for (;;) {
+		std::unique_lock<std::mutex> lock(g_picLock);
+		g_picCv.wait(lock, [] { return g_picPending; });
+		lock.unlock();
+		u16 *dst = (u16 *)g_picRaw;
+		const u8 *src = g_picIn;
+		for (int i = 0; i < kPicW * kPicH; i++, src += 4)
+			*dst++ = (u16)(((src[0] >> 3) << 11) | ((src[1] >> 2) << 5) | (src[2] >> 3));
+		const size_t z = ZSTD_compressCCtx(g_pcctx, g_picZ, kPicCap, g_picRaw, kPicRaw, 1);
+		lock.lock();
+		g_picOutSize = ZSTD_isError(z) ? 0 : z;
+		g_picPending = false;
+		g_picDone = true;
+		g_picCv.notify_all();
+	}
+}
+
+void *Alloc(size_t size);
+
+// The worker's finished picture into the history; wait: for the worker to be idle first.
+void CollectPicture(bool wait) {
+	std::unique_lock<std::mutex> lock(g_picLock);
+	if (wait)
+		g_picCv.wait(lock, [] { return !g_picPending; });
+	if (!g_picDone)
+		return;
+	g_picDone = false;
+	if (g_picOutSize) {
+		if (void *p = Alloc(g_picOutSize)) {
+			memcpy(p, g_picZ, g_picOutSize);
+			g_pics.push_back({ p, (u32)g_picOutSize, g_picTag });
+		}
+	}
+}
+
+bool Init() {
+	if (g_initTried)
+		return g_ready;
+	g_initTried = true;
+	// Leave the rest of the direct memory to the GPU (Vulkan's allocations come from it too).
+	for (size_t mb : { 640, 512, 448 }) {
+		const size_t len = mb * MB;
+		off_t phys = 0;
+		if (sceKernelAllocateDirectMemory(0, (off_t)sceKernelGetDirectMemorySize(), len, LARGE_PAGE, 0, &phys) != 0)
+			continue;
+		void *addr = nullptr;
+		if (sceKernelMapDirectMemory(&addr, len, 0x3, 0, phys, LARGE_PAGE) != 0) {
+			sceKernelReleaseDirectMemory(phys, len);
+			continue;
+		}
+		u8 *p = (u8 *)addr;
+		g_cur.data = p;
+		g_next.data = p += kSnapshotCap;
+		g_zout = p += kSnapshotCap;
+		g_picRaw = p += kSnapshotCap;
+		g_picZ = p += kPicRaw;
+		g_picRgba = p += kPicCap;
+		g_picRead = p += kPicW * kPicH * 4;
+		g_picIn = p += kPicW * kPicH * 4;
+		g_space = create_mspace_with_base((u8 *)addr + kFixed, len - kFixed, 1);
+		g_cctx = ZSTD_createCCtx();
+		g_pcctx = ZSTD_createCCtx();
+		g_dctx = ZSTD_createDCtx();
+		if (!g_space || !g_cctx || !g_pcctx || !g_dctx)
+			break;
+		g_ready = true;
+		g_picThread = std::thread(PictureWorker);
+		g_picThread.detach();
+		NOTICE_LOG(Log::SaveState, "Rewind: %d MiB of direct memory (%d MiB for the history)", (int)mb, (int)((len - kFixed) / MB));
+		return true;
+	}
+	WARN_LOG(Log::SaveState, "Rewind: no direct memory for it, rewind is off");
+	return false;
+}
+
+u32 OldestId() {
+	return g_curId - (u32)g_deltas.size() - (g_pending ? 1 : 0);  // (one more while a difference is being made)
+}
+
+void DropUnreachablePics() {
+	const u32 oldest = OldestId();
+	while (!g_pics.empty() && g_pics.front().tag < oldest) {
+		mspace_free(g_space, g_pics.front().data);
+		g_pics.pop_front();
+	}
+}
+
+// Room in the history: the oldest go first (a snapshot, and the pictures it was the last of).
+void *Alloc(size_t size) {
+	for (;;) {
+		if (void *p = mspace_malloc(g_space, size))
+			return p;
+		if (!g_deltas.empty()) {
+			mspace_free(g_space, g_deltas.front().data);
+			g_deltas.pop_front();
+			DropUnreachablePics();
+		} else if (!g_pics.empty()) {
+			mspace_free(g_space, g_pics.front().data);
+			g_pics.pop_front();
+		} else {
+			return nullptr;
+		}
+		if (g_shown >= (int)g_pics.size())
+			g_shown = (int)g_pics.size() - 1;
+	}
+}
+
+void ClearHistory() {
+	for (const Delta &d : g_deltas)
+		mspace_free(g_space, d.data);
+	g_deltas.clear();
+	for (const Pic &p : g_pics)
+		mspace_free(g_space, p.data);
+	g_pics.clear();
+}
+
+void Put32(u8 *p, u32 v) {
+	memcpy(p, &v, 4);
+}
+
+u32 Get32(const u8 *p) {
+	u32 v;
+	memcpy(&v, p, 4);
+	return v;
+}
+
+// (the worker) What turns newer back into older: older's size, then each block of older that newer
+// doesn't have (its index, then its bytes), compressed as one zstd frame into g_zout.
+void Encode(const Buffer &older, const Buffer &newer) {
+	ZSTD_CCtx_reset(g_cctx, ZSTD_reset_session_only);
+	ZSTD_CCtx_setParameter(g_cctx, ZSTD_c_compressionLevel, 1);
+	ZSTD_outBuffer out{ g_zout, kSnapshotCap, 0 };
+	size_t rawSize = 0;
+	bool ok = true;
+	auto feed = [&](const void *src, size_t n, ZSTD_EndDirective end) {
+		ZSTD_inBuffer in{ src, n, 0 };
+		while (ok) {
+			const size_t r = ZSTD_compressStream2(g_cctx, &out, &in, end);
+			if (ZSTD_isError(r) || (out.pos == out.size && (end == ZSTD_e_end ? r != 0 : in.pos < in.size))) {
+				ok = false;  // (or it didn't fit: a difference as big as a whole snapshot)
+			} else if (end == ZSTD_e_end ? r == 0 : in.pos == in.size) {
+				break;
+			}
+		}
+		rawSize += n;
+	};
+	u8 word[4];
+	Put32(word, (u32)older.size);
+	feed(word, 4, ZSTD_e_continue);
+	for (size_t at = 0; at < older.size && ok; at += kBlock) {
+		const size_t n = std::min(kBlock, older.size - at);
+		if (at + n <= newer.size && memcmp(older.data + at, newer.data + at, n) == 0)
+			continue;
+		Put32(word, (u32)(at / kBlock));
+		feed(word, 4, ZSTD_e_continue);
+		feed(older.data + at, n, ZSTD_e_continue);
+	}
+	feed(nullptr, 0, ZSTD_e_end);
+	g_pendingOk = ok && rawSize <= kSnapshotCap;
+	g_pendingSize = out.pos;
+	g_pendingRaw = rawSize;
+}
+
+// Waits for the worker and keeps what it made; g_cur is the newest snapshot after this.
+void Join() {
+	if (g_worker.joinable())
+		g_worker.join();
+	if (!g_pending)
+		return;
+	g_pending = false;
+	std::swap(g_cur, g_next);
+	void *p = g_pendingOk ? Alloc(g_pendingSize) : nullptr;
+	if (p) {
+		memcpy(p, g_zout, g_pendingSize);
+		g_deltas.push_back({ p, (u32)g_pendingSize, (u32)g_pendingRaw });
+	} else {
+		// the older snapshots can't be reached without this difference
+		for (const Delta &d : g_deltas)
+			mspace_free(g_space, d.data);
+		g_deltas.clear();
+		DropUnreachablePics();
+	}
+}
+
+void Snapshot() {
+	Join();
+	const double start = time_now_d();
+	if (SaveState::SaveToBuffer(g_next.data, kSnapshotCap, &g_next.size) != CChunkFileReader::ERROR_NONE) {
+		WARN_LOG(Log::SaveState, "Rewind: a snapshot didn't fit in %d MiB", (int)(kSnapshotCap / MB));
+		return;
+	}
+	g_snapMs += (time_now_d() - start) * 1000.0;
+	g_snaps++;
+	if (!g_haveCur) {
+		std::swap(g_cur, g_next);
+		g_haveCur = true;
+		return;
+	}
+	g_curId++;  // (the pictures from here on come after this one)
+	g_pending = true;
+	g_worker = std::thread([] {
+		SetCurrentThreadName("M33Rewind");
+		Encode(g_cur, g_next);
+	});
+}
+
+// g_cur back one snapshot; false at the oldest.
+bool StepBack() {
+	Join();
+	if (g_deltas.empty())
+		return false;
+	const Delta d = g_deltas.back();
+	g_deltas.pop_back();
+	const size_t r = ZSTD_decompressDCtx(g_dctx, g_next.data, kSnapshotCap, d.data, d.size);
+	mspace_free(g_space, d.data);
+	if (ZSTD_isError(r) || r != d.rawSize || r < 4) {
+		ERROR_LOG(Log::SaveState, "Rewind: a snapshot didn't decompress");
+		ClearHistory();
+		return false;
+	}
+	const u8 *p = g_next.data;
+	const size_t oldSize = Get32(p);
+	if (oldSize > kSnapshotCap) {
+		ClearHistory();
+		return false;
+	}
+	g_cur.size = oldSize;  // (a grown part is all in the difference: those blocks differed)
+	for (size_t at = 4; at + 4 <= r;) {
+		const size_t off = (size_t)Get32(p + at) * kBlock;
+		at += 4;
+		if (off >= oldSize)
+			break;
+		const size_t n = std::min(kBlock, oldSize - off);
+		if (at + n > r)
+			break;
+		memcpy(g_cur.data + off, p + at, n);
+		at += n;
+	}
+	g_curId--;
+	return true;
+}
+
+void TakePicture(Draw::DrawContext *draw) {
+	if (!gpu || !g_haveCur || !draw)
+		return;
+	const double start = time_now_d();
+	// The displayed picture blitted down to 480x272 on the GPU, and read back late: what comes back is
+	// the copy made a few frames ago, without waiting for the GPU. (A blocking readback made the CPU
+	// wait for the GPU to finish everything: 12-27 ms, 30 times a second, and the game fell behind
+	// with its sound.)
+	if (!g_picFbo) {
+		Draw::FramebufferDesc desc{ kPicW, kPicH, 1, 1, 0, false, "M33RewindPicture" };
+		g_picFbo = draw->CreateFramebuffer(desc);
+		if (!g_picFbo)
+			return;
+	}
+	if (!gpu->BlitDisplayTo(g_picFbo, kPicW, kPicH))
+		return;
+	CollectPicture(false);
+	if (draw->CopyFramebufferToMemory(g_picFbo, Draw::Aspect::COLOR_BIT, 0, 0, kPicW, kPicH, Draw::DataFormat::R8G8B8A8_UNORM,
+			g_picRead, kPicW, Draw::ReadbackMode::OLD_DATA_OK, "M33RewindPicture") && g_picReadValid++ > 0) {
+		std::lock_guard<std::mutex> lock(g_picLock);
+		if (!g_picPending && !g_picDone) {  // (else the worker's behind: this picture is skipped)
+			std::swap(g_picRead, g_picIn);
+			g_picTag = g_curId;
+			g_picPending = true;
+			g_picCv.notify_all();
+		}
+	}
+	g_picMs += (time_now_d() - start) * 1000.0;
+	if (++g_picsTaken == 600) {
+		size_t bytes = 0;
+		for (const Delta &d : g_deltas)
+			bytes += d.size;
+		for (const Pic &p : g_pics)
+			bytes += p.size;
+		float vps = 0, fps = 0, actual = 0;
+		__DisplayGetFPS(&vps, &fps, &actual);
+		NOTICE_LOG(Log::SaveState, "Rewind: %d slow frames (%d right after a snapshot); game at %.0f fps (%.0f%% speed); snapshot %.1f MiB in %.1f ms, picture in %.1f ms; %.1f s kept (%d snapshots, %d pictures, %.0f MiB)",
+			g_slowFrames, g_slowAfterSnapshot, actual, vps / 59.94f * 100.0f, g_cur.size / (double)MB, g_snaps ? g_snapMs / g_snaps : 0.0, g_picMs / g_picsTaken,
+			g_pics.size() / kPicsPerSecond, (int)g_deltas.size(), (int)g_pics.size(), bytes / (double)MB);
+		g_picsTaken = g_snaps = 0;
+		g_slowFrames = g_slowAfterSnapshot = 0;
+		g_picMs = g_snapMs = 0.0;
+	}
+}
+
+// The picture at g_shown into g_picRgba, for the texture.
+void Unpack(int index) {
+	const Pic &pic = g_pics[index];
+	const size_t r = ZSTD_decompressDCtx(g_dctx, g_picRaw, kPicRaw, pic.data, pic.size);
+	if (ZSTD_isError(r) || r != kPicRaw)
+		return;
+	const u16 *src = (const u16 *)g_picRaw;
+	u32 *dst = (u32 *)g_picRgba;
+	for (int i = 0; i < kPicW * kPicH; i++) {
+		const u16 c = src[i];
+		const u32 r5 = c >> 11, g6 = (c >> 5) & 63, b5 = c & 31;
+		dst[i] = 0xFF000000 | ((b5 * 255 / 31) << 16) | ((g6 * 255 / 63) << 8) | (r5 * 255 / 31);
+	}
+	g_texDirty = true;
+}
+
+// Going back to picture `index`: the snapshots along with it.
+bool Show(int index) {
+	const u32 tag = g_pics[index].tag;
+	while (g_curId > tag) {
+		if (!StepBack())
+			return false;
+	}
+	g_shown = index;
+	Unpack(index);
+	return true;
+}
+
+void Resume() {
+	// Carry on from the snapshot of the picture shown; what's after it is gone.
+	std::string error;
+	const double start = time_now_d();
+	if (SaveState::LoadFromBuffer(g_cur.data, g_cur.size, &error) != CChunkFileReader::ERROR_NONE) {
+		ERROR_LOG(Log::SaveState, "Rewind: loading the snapshot failed (%s)", error.c_str());
+		M33Rewind_Reset();
+		return;
+	}
+	while (!g_pics.empty() && g_pics.back().tag >= g_curId) {
+		mspace_free(g_space, g_pics.back().data);
+		g_pics.pop_back();
+	}
+	NOTICE_LOG(Log::SaveState, "Rewind: went back %d pictures (%.1f s), loaded in %.1f ms; %.1f s left",
+		g_steps, g_steps / kPicsPerSecond, (time_now_d() - start) * 1000.0, g_pics.size() / kPicsPerSecond);
+}
+
+}  // namespace
+
+bool M33Rewind_Frame(bool held) {
+	// A savestate load like any other: not in hardcore mode.
+	if (Achievements::HardcoreModeActive() || !Init()) {
+		g_active = false;
+		return false;
+	}
+	if (!g_Config.bM33Rewind) {
+		// off (the quick menu, per game): nothing recorded, nothing spent
+		if (g_haveCur || !g_pics.empty())
+			M33Rewind_Reset();
+		g_active = false;
+		return false;
+	}
+	auto sy = GetI18NCategory(I18NCat::SYSTEM);
+	const double now = time_now_d();
+	if (held && !g_rewinding && g_ready)
+		CollectPicture(true);
+	if (held && (g_rewinding || !g_pics.empty())) {
+		if (!g_rewinding) {
+			Join();
+			g_rewinding = true;
+			g_active = true;
+			g_heldSince = g_lastStep = now;
+			g_owed = 0.0;
+			g_steps = 0;
+			g_endShown = false;
+			if (!Show((int)g_pics.size() - 1)) {
+				g_rewinding = false;
+				g_active = false;
+				return false;
+			}
+		} else {
+			// 1x, then up to 3x after a second held
+			const double speed = 1.0 + std::clamp(now - g_heldSince - 1.0, 0.0, 2.0);
+			g_owed += (now - g_lastStep) * kPicsPerSecond * speed;
+			g_lastStep = now;
+			const int steps = std::min((int)g_owed, 8);
+			g_owed -= (int)g_owed;
+			if (steps > 0) {
+				const int target = std::max(0, g_shown - steps);
+				bool ok = target < g_shown && Show(target);
+				if (ok)
+					g_steps += steps;
+				if ((!ok || target == 0) && !g_endShown) {
+					g_endShown = true;
+					g_OSD.Show(OSDType::MESSAGE_INFO, sy->T("Reached the end of the rewind buffer"), 2.0f, "m33-rewind-end");
+				}
+			}
+		}
+		g_OSD.Show(OSDType::MESSAGE_INFO, "\xE2\x97\x80\xE2\x97\x80  " + std::string(sy->T("Rewind")), 0.3f, "m33-rewind");
+		return true;
+	}
+	if (g_rewinding) {
+		g_rewinding = false;
+		g_active = false;
+		Resume();
+		g_snapFrames = g_picFrames = 0;
+	}
+	// A snapshot takes ~14 ms of the emulation thread: in a frame with room to spare, so a heavy
+	// scene doesn't stutter on it; at the latest every kSnapMaxFrames. Slow frames are counted.
+	const double frameMs = g_lastFrameAt > 0.0 ? (now - g_lastFrameAt) * 1000.0 : 0.0;
+	g_lastFrameAt = now;
+	if (frameMs > 25.0) {
+		g_slowFrames++;
+		if (g_lastWasSnapshot)
+			g_slowAfterSnapshot++;
+	}
+	g_lastWasSnapshot = false;
+	if (++g_snapFrames >= kSnapInterval && (frameMs < 15.0 || g_snapFrames >= kSnapMaxFrames)) {
+		g_snapFrames = 0;
+		Snapshot();
+		g_lastWasSnapshot = true;
+	}
+	return false;
+}
+
+void M33Rewind_AfterFrame(Draw::DrawContext *draw) {
+	if (!g_ready || g_rewinding || !g_Config.bM33Rewind)
+		return;
+	if (++g_picFrames >= kPicInterval) {
+		g_picFrames = 0;
+		TakePicture(draw);
+	}
+}
+
+bool M33Rewind_Active() {
+	return g_active;
+}
+
+void M33Rewind_Draw(UIContext &dc, const Bounds &bounds) {
+	if (!g_active || g_shown < 0)
+		return;
+	Draw::DrawContext *draw = dc.GetDrawContext();
+	if (!g_tex) {
+		Draw::TextureDesc desc{};
+		desc.type = Draw::TextureType::LINEAR2D;
+		desc.format = Draw::DataFormat::R8G8B8A8_UNORM;
+		desc.width = kPicW;
+		desc.height = kPicH;
+		desc.depth = 1;
+		desc.mipLevels = 1;
+		desc.tag = "M33Rewind";
+		desc.initData.push_back(g_picRgba);
+		g_tex = draw->CreateTexture(desc);
+		g_texDirty = false;
+		if (!g_tex)
+			return;
+	}
+	if (g_texDirty) {
+		const uint8_t *levels[1] = { g_picRgba };
+		draw->UpdateTextureLevels(g_tex, levels, Draw::TextureCallback(), 1);
+		g_texDirty = false;
+	}
+	// where the game's picture is: the PSP's screen, letterboxed
+	const float s = std::min(bounds.w / kPicW, bounds.h / kPicH);
+	const Bounds pic(bounds.centerX() - kPicW * s / 2.0f, bounds.centerY() - kPicH * s / 2.0f, kPicW * s, kPicH * s);
+	dc.Begin();
+	dc.Draw()->Rect(bounds.x, bounds.y, bounds.w, bounds.h, 0xFF000000);
+	dc.Flush();
+	draw->BindTexture(0, g_tex);
+	dc.Draw()->DrawTexRect(pic, 0, 0, 1, 1, 0xFFFFFFFF);
+	dc.Flush();
+	dc.RebindTexture();
+}
+
+void M33Rewind_Reset() {
+	if (!g_ready)
+		return;
+	if (g_worker.joinable())
+		g_worker.join();
+	g_pending = false;
+	{
+		std::unique_lock<std::mutex> lock(g_picLock);
+		g_picCv.wait(lock, [] { return !g_picPending; });
+		g_picDone = false;
+	}
+	ClearHistory();
+	g_cur.size = g_next.size = 0;
+	g_curId = 0;
+	g_haveCur = false;
+	g_rewinding = false;
+	g_active = false;
+	g_shown = -1;
+	g_snapFrames = g_picFrames = 0;
+	if (g_tex) {
+		g_tex->Release();
+		g_tex = nullptr;
+	}
+	if (g_picFbo) {
+		g_picFbo->Release();
+		g_picFbo = nullptr;
+	}
+	g_picReadValid = 0;
+}
