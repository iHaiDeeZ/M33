+// The opening (4.2 s, any button skips it), over a deep indigo field with a perspective grid:
+//   0.0  fade in from black, the glow behind the logo swells
+//   0.25 the ring (a PSP's outline) draws itself from the top, both ways, violet to cyan
+//   0.75 M33 settles in from a slight zoom, with a violet/cyan glow that pulses once at 2.0
+//   1.3  the accent line opens under the ring; 1.6 MARCH33 rises in; 1.9 the tagline
+//   2.2  the credit line (PPSSPP, its author, its license), as PPSSPP's own logo screen has it
+//   3.6  everything fades out to the menus
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+#include "Common/Data/Color/RGBAUtil.h"
+#include "Common/Math/geom2d.h"
+#include "Common/Render/DrawBuffer.h"
+#include "Common/Render/TextureAtlas.h"
+#include "Common/UI/Context.h"
+#include "Common/UI/View.h"
+#include "Core/Config.h"
+#include "ps4/PS4Brand.h"
+
+const std::string &M33_Version() {
+	static std::string version;
+	if (version.empty()) {
+		version = "?";
+		if (FILE *f = fopen("/app0/version.txt", "r")) {
+			char buf[32]{};
+			if (fgets(buf, sizeof(buf), f)) {
+				std::string v(buf);
+				while (!v.empty() && (v.back() == '\n' || v.back() == '\r' || v.back() == ' '))
+					v.pop_back();
+				if (!v.empty())
+					version = v;
+			}
+			fclose(f);
+		}
+	}
+	return version;
+}
+
+std::string M33_VersionLine() {
+	return "M33 " + M33_Version() + " (PPSSPP " + std::string(PPSSPP_GIT_VERSION) + ")";
+}
+
+namespace {
+
+constexpr float kPi = 3.14159265f;
+
+// 0xAABBGGRR, as the draw buffer wants
+uint32_t Rgba(int r, int g, int b, float a) {
+	const int ia = std::clamp((int)(a * 255.0f), 0, 255);
+	return ((uint32_t)ia << 24) | ((uint32_t)b << 16) | ((uint32_t)g << 8) | (uint32_t)r;
+}
+
+uint32_t Mix(int r1, int g1, int b1, int r2, int g2, int b2, float t, float a) {
+	t = std::clamp(t, 0.0f, 1.0f);
+	return Rgba((int)(r1 + (r2 - r1) * t), (int)(g1 + (g2 - g1) * t), (int)(b1 + (b2 - b1) * t), a);
+}
+
+// violet (#A05CFF) to cyan (#40DCFF)
+uint32_t Brand(float t, float a) {
+	return Mix(160, 92, 255, 64, 220, 255, t, a);
+}
+
+float Smooth(float a, float b, float t) {
+	const float x = std::clamp((t - a) / (b - a), 0.0f, 1.0f);
+	return x * x * (3.0f - 2.0f * x);
+}
+
+float EaseOutCubic(float x) {
+	x = std::clamp(x, 0.0f, 1.0f);
+	return 1.0f - (1.0f - x) * (1.0f - x) * (1.0f - x);
+}
+
+// 0 -> 1 -> 0 over [a, b]
+float Bump(float a, float b, float t) {
+	if (t <= a || t >= b)
+		return 0.0f;
+	return sinf((t - a) / (b - a) * kPi);
+}
+
+// A point on a stadium (centered on 0, straight half-length `half`, radius `r`), `s` along its
+// outline clockwise from the top center.
+void Stadium(float half, float r, float s, float *x, float *y) {
+	const float arc = kPi * r;
+	if (s < half) {
+		*x = s; *y = -r;
+		return;
+	}
+	s -= half;
+	if (s < arc) {
+		const float a = -kPi / 2 + s / r;
+		*x = half + cosf(a) * r; *y = sinf(a) * r;
+		return;
+	}
+	s -= arc;
+	if (s < 2 * half) {
+		*x = half - s; *y = r;
+		return;
+	}
+	s -= 2 * half;
+	if (s < arc) {
+		const float a = kPi / 2 + s / r;
+		*x = -half + cosf(a) * r; *y = sinf(a) * r;
+		return;
+	}
+	s -= arc;
+	*x = -half + s; *y = -r;
+}
+
+// An atlas image at (cx, cy) center, `width` wide, with a vertical gradient.
+void DrawImageCentered(UIContext &dc, ImageID id, float cx, float cy, float width, uint32_t top, uint32_t bottom) {
+	const AtlasImage *img = dc.Draw()->GetAtlas()->getImage(id);
+	if (!img || img->w <= 0)
+		return;
+	const float height = width * (float)img->h / (float)img->w;
+	dc.Draw()->DrawImageStretchVGradient(id, cx - width / 2, cy - height / 2, cx + width / 2, cy + height / 2, top, bottom);
+}
+
+// The same, as a soft glow: copies around the point, in a color, faint.
+void DrawGlow(UIContext &dc, ImageID id, float cx, float cy, float width, float radius, uint32_t color) {
+	const int kSteps = 12;
+	for (int i = 0; i < kSteps; i++) {
+		const float a = i * 2 * kPi / kSteps;
+		for (float k : { 1.0f, 0.5f })
+			DrawImageCentered(dc, id, cx + cosf(a) * radius * k, cy + sinf(a) * radius * k, width, color, color);
+	}
+}
+
+}  // namespace
+
+void M33_DrawIntro(UIContext &dc, const Bounds &bounds, double time) {
+	const float t = (float)time;
+	const float W = bounds.w, H = bounds.h;
+	const float cx = bounds.centerX();
+	const float cy = bounds.y + H * 0.42f;
+	const float fade = 1.0f - Smooth(M33_INTRO_SECONDS - 0.6f, M33_INTRO_SECONDS, t);
+	const float bgIn = Smooth(0.0f, 0.5f, t);
+	DrawBuffer *draw = dc.Draw();
+	const ImageID white("I_SOLIDWHITE");
+
+	dc.Begin();
+
+	// The field: black, then deep indigo, darker at the bottom.
+	draw->Rect(bounds.x, bounds.y, W, H, 0xFF000000);
+	draw->RectVGradient(bounds.x, bounds.y, bounds.x2(), bounds.y2(), Rgba(20, 12, 51, bgIn * fade), Rgba(5, 4, 16, bgIn * fade));
+
+	// The glow behind the logo: stacked faint discs.
+	const float glow = bgIn * fade * (0.85f + 0.15f * Bump(1.9f, 2.7f, t));
+	for (int i = 0; i < 10; i++) {
+		const float r = H * (0.12f + 0.05f * i);
+		draw->FillCircle(cx, cy, r, 64, Rgba(70, 38, 160, 0.045f * glow));
+	}
+
+	// The grid: lines fan out from the horizon, rows drift towards the viewer.
+	const float horizon = bounds.y + H * 0.80f;
+	const float gridA = 0.16f * bgIn * fade;
+	for (int i = -16; i <= 16; i++) {
+		draw->Line(white, cx + i * W * 0.0135f, horizon, cx + i * W * 0.16f, bounds.y2(), 1.0f, Rgba(120, 90, 255, gridA));
+	}
+	const float drift = fmodf(t * 0.35f, 1.0f);
+	for (int k = 0; k < 9; k++) {
+		const float f = (k + drift) / 9.0f;
+		const float y = horizon + (bounds.y2() - horizon) * f * f;
+		draw->Line(white, bounds.x, y, bounds.x2(), y, 1.0f, Rgba(120, 90, 255, gridA * std::min(1.0f, f * 3.0f)));
+	}
+
+	// The ring, drawn from the top center both ways.
+	const float ringW = std::min(W * 0.60f, H * 1.25f);
+	const float ringH = ringW * 0.42f;
+	const float r = ringH / 2, half = (ringW - ringH) / 2;
+	const float perimeter = 4 * half + 2 * kPi * r;
+	const float ringP = EaseOutCubic(Smooth(0.25f, 1.35f, t) * 1.0f);
+	if (ringP > 0.0f) {
+		const int kSegments = 180;
+		const float reach = ringP * perimeter / 2;
+		for (int side = -1; side <= 1; side += 2) {
+			float px, py;
+			Stadium(half, r, 0.0f, &px, &py);
+			for (int i = 1; i <= kSegments; i++) {
+				const float s = reach * i / kSegments;
+				float x, y;
+				Stadium(half, r, s, &x, &y);
+				const float ax = cx + side * px, ay = cy + py, bx = cx + side * x, by = cy + y;
+				const float hue = (bx - (cx - ringW / 2)) / ringW;
+				draw->Line(white, ax, ay, bx, by, 9.0f, Brand(hue, 0.10f * fade));
+				draw->Line(white, ax, ay, bx, by, 3.0f, Brand(hue, 0.95f * fade));
+				px = x; py = y;
+			}
+		}
+		// the bright tips while it draws
+		if (ringP < 0.999f) {
+			float x, y;
+			Stadium(half, r, reach, &x, &y);
+			for (int side = -1; side <= 1; side += 2) {
+				draw->FillCircle(cx + side * x, cy + y, 9.0f, 24, Rgba(200, 230, 255, 0.25f * fade));
+				draw->FillCircle(cx + side * x, cy + y, 4.0f, 16, Rgba(255, 255, 255, 0.9f * fade));
+			}
+		}
+	}
+
+	// M33: zooms in slightly as it fades in, glows violet and cyan.
+	const float logoA = Smooth(0.75f, 1.55f, t) * fade;
+	if (logoA > 0.0f) {
+		const float zoom = 1.12f - 0.12f * EaseOutCubic(Smooth(0.75f, 1.55f, t));
+		const float logoW = ringW * 0.70f * zoom;
+		const ImageID logo("I_M33_INTRO");
+		const float pulse = 1.0f + 0.8f * Bump(1.9f, 2.7f, t);
+		DrawGlow(dc, logo, cx, cy, logoW, 10.0f * pulse, Rgba(160, 92, 255, 0.05f * logoA * pulse));
+		DrawGlow(dc, logo, cx, cy + 3.0f, logoW, 4.0f * pulse, Rgba(64, 220, 255, 0.07f * logoA * pulse));
+		DrawImageCentered(dc, logo, cx, cy, logoW, Rgba(255, 255, 255, logoA), Rgba(214, 226, 255, logoA));
+	}
+
+	// The accent line under the ring, opening from the middle.
+	const float lineY = cy + r + H * 0.05f;
+	const float lineP = EaseOutCubic(Smooth(1.3f, 1.9f, t));
+	if (lineP > 0.0f) {
+		const float halfW = ringW * 0.33f * lineP;
+		const int kPieces = 48;
+		for (int i = 0; i < kPieces; i++) {
+			const float u = (float)i / kPieces;
+			const float x1 = cx - halfW + 2 * halfW * u, x2 = cx - halfW + 2 * halfW * (u + 1.0f / kPieces);
+			const float edge = 1.0f - fabsf(u * 2 - 1);
+			draw->Rect(x1, lineY, x2 - x1 + 0.5f, 3.0f, Brand(u, (0.25f + 0.75f * edge) * fade));
+		}
+	}
+
+	// MARCH33, rising in; then the tagline.
+	const float marchA = Smooth(1.6f, 2.2f, t) * fade;
+	if (marchA > 0.0f) {
+		const float rise = (1.0f - EaseOutCubic(Smooth(1.6f, 2.2f, t))) * 14.0f;
+		DrawImageCentered(dc, ImageID("I_M33_MARCH"), cx, lineY + H * 0.055f + rise, ringW * 0.44f, Rgba(236, 238, 255, marchA), Rgba(200, 206, 255, marchA));
+	}
+	const float tagA = Smooth(1.9f, 2.5f, t) * fade;
+	if (tagA > 0.0f) {
+		DrawImageCentered(dc, ImageID("I_M33_TAGLINE"), cx, lineY + H * 0.115f, ringW * 0.54f, Rgba(154, 164, 216, tagA), Rgba(154, 164, 216, tagA));
+	}
+
+	// The credit line and the version.
+	const float creditA = Smooth(2.2f, 2.7f, t) * fade;
+	if (creditA > 0.0f) {
+		dc.SetFontStyle(dc.GetTheme().uiFont);
+		dc.SetFontScale(0.75f, 0.75f);
+		dc.DrawText("Based on PPSSPP by Henrik Rydg\xc3\xa5rd \xc2\xb7 Free Software under GPL 2.0+", cx, bounds.y2() - H * 0.07f, Rgba(140, 144, 190, creditA), ALIGN_HCENTER);
+		dc.DrawText(M33_Version(), bounds.x2() - 24.0f, bounds.y2() - H * 0.07f, Rgba(110, 112, 160, creditA), ALIGN_RIGHT);
+		dc.SetFontScale(1.0f, 1.0f);
+	}
+
+	dc.Flush();
+}
