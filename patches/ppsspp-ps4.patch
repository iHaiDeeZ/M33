+#include "Common/UI/View.h"
+#include "Common/UI/ViewGroup.h"
+#include "Core/Config.h"
+#include "Core/ConfigValues.h"
+#include "Core/ELF/ParamSFO.h"
+#include "Core/SaveState.h"
+#include "Core/System.h"
+#include "UI/DisplayLayoutScreen.h"
+#include "UI/GameSettingsScreen.h"
+#include "UI/PauseScreen.h"
+#include "ps4/PS4Cheats.h"
+#include "ps4/PS4Lang.h"
+#include "ps4/PS4QuickMenu.h"
+
+namespace {
+
+constexpr uint32_t ACCENT = 0x9B7BFF, TEXT = 0xFFFFFF, WARN = 0xFFC870;
+
+// RGB to the UI's ABGR, with alpha
+uint32_t Col(uint32_t rgb, float a) {
+	const uint32_t r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
+	return ((uint32_t)(std::clamp(a, 0.0f, 1.0f) * 255.0f) << 24) | (b << 16) | (g << 8) | r;
+}
+
+enum Row {
+	ROW_RESUME,
+	ROW_SAVE,
+	ROW_LOAD,
+	ROW_REWIND,
+	ROW_FRAMEGEN,
+	ROW_CHEATS,
+	ROW_RESOLUTION,
+	ROW_VOLUME,
+	ROW_COUNTER,
+	ROW_SETTINGS,
+	ROW_DISPLAY,
+	ROW_RESTART,
+	ROW_EXIT,
+	ROW_COUNT,
+};
+
+const char *const kRowLabels[ROW_COUNT] = {
+	"Resume", "Save State", "Load State", "Rewind (L2)", "Frame Generation", "Cheats", "Resolution", "Game Volume", "FPS Counter",
+	"Settings", "Display & Effects", "Restart Game", "Exit to M33",
+};
+
+class M33QuickMenu : public UIScreen {
+public:
+	M33QuickMenu(const Path &gamePath) : gamePath_(gamePath) {
+		statePrefix_ = SaveState::GetGamePrefix(g_paramSFO);
+		SaveState::Rescan(statePrefix_);
+		slot_ = SaveState::GetCurrentSlot();
+		title_ = g_paramSFO.GetValueString("TITLE");
+		M33Cheats::Load();
+		opened_ = lastTime_ = time_now_d();
+	}
+
+	const char *tag() const override { return "M33QuickMenu"; }
+	bool isTransparent() const override { return true; }
+
+	void CreateViews() override {
+		root_ = new UI::AnchorLayout(new UI::LayoutParams(UI::FILL_PARENT, UI::FILL_PARENT));
+	}
+
+	void update() override {
+		UIScreen::update();
+		UpdateUIState(UISTATE_PAUSEMENU);
+		// held directions repeat
+		const double now = time_now_d();
+		if (held_ && now >= repeatAt_) {
+			Move(held_);
+			repeatAt_ = now + 0.08;
+		}
+	}
+
+	bool key(const KeyInput &key) override {
+		if (!(key.flags & (KeyInputFlags::DOWN | KeyInputFlags::UP)))
+			return false;
+		const bool down = (key.flags & KeyInputFlags::DOWN) != 0;
+		int dir = 0;
+		switch (key.keyCode) {
+		case NKCODE_DPAD_UP: dir = DIR_UP; break;
+		case NKCODE_DPAD_DOWN: dir = DIR_DOWN; break;
+		case NKCODE_DPAD_LEFT: dir = DIR_LEFT; break;
+		case NKCODE_DPAD_RIGHT: dir = DIR_RIGHT; break;
+		default: break;
+		}
+		if (dir) {
+			Hold(dir, down);
+			return true;
+		}
+		if (!down)
+			return true;
+		// L3 + R3 again (the key PS4Pad sends for it): close; not the press that opened it
+		if (key.keyCode == NKCODE_BUTTON_L2) {
+			if (time_now_d() - opened_ > 0.4)
+				Resume();
+			return true;
+		}
+		if (UI::IsAcceptKey(key)) {
+			Activate();
+			return true;
+		}
+		if (UI::IsEscapeKey(key)) {
+			if (cheatsPage_) {
+				cheatsPage_ = false;
+				UI::PlayUISound(UI::UISound::BACK);
+			} else {
+				Resume();
+			}
+			return true;
+		}
+		return true;
+	}
+
+	void axis(const AxisInput &axis) override {
+		// the left stick, as the D-pad
+		if (axis.axisId == JOYSTICK_AXIS_Y) {
+			const int dir = axis.value < -0.6f ? DIR_UP : (axis.value > 0.6f ? DIR_DOWN : 0);
+			if (dir != stickY_) {
+				if (stickY_)
+					Hold(stickY_, false);
+				stickY_ = dir;
+				if (dir)
+					Hold(dir, true);
+			}
+		} else if (axis.axisId == JOYSTICK_AXIS_X) {
+			const int dir = axis.value < -0.6f ? DIR_LEFT : (axis.value > 0.6f ? DIR_RIGHT : 0);
+			if (dir != stickX_) {
+				if (stickX_)
+					Hold(stickX_, false);
+				stickX_ = dir;
+				if (dir)
+					Hold(dir, true);
+			}
+		}
+	}
+
+	void dialogFinished(const Screen *dialog, DialogResult result) override {
+		// back from PPSSPP's settings or display screens
+		M33Cheats::Load();
+	}
+
+protected:
+	void DrawForeground(UIContext &dc) override;
+
+private:
+	enum { DIR_UP = 1, DIR_DOWN, DIR_LEFT, DIR_RIGHT };
+
+	void Hold(int dir, bool down) {
+		if (down) {
+			held_ = dir;
+			Move(dir);
+			repeatAt_ = time_now_d() + 0.35;
+		} else if (held_ == dir) {
+			held_ = 0;
+		}
+	}
+
+	// The selectable rows of the cheats page (its section titles skipped)
+	int CheatRows() const { return (int)M33Cheats::Items().size() + 1; }  // + the import row
+
+	void Move(int dir) {
+		if (cheatsPage_) {
+			const int n = CheatRows();
+			if (dir == DIR_UP || dir == DIR_DOWN) {
+				int i = cheatSel_;
+				for (int tries = 0; tries < n; tries++) {
+					i = (i + (dir == DIR_UP ? n - 1 : 1)) % n;
+					if (i == 0 || !M33Cheats::Items()[i - 1].header)
+						break;
+				}
+				cheatSel_ = i;
+				UI::PlayUISound(UI::UISound::SELECT);
+			} else if (cheatSel_ > 0) {
+				Activate();
+			}
+			return;
+		}
+		if (dir == DIR_UP || dir == DIR_DOWN) {
+			sel_ = (sel_ + (dir == DIR_UP ? ROW_COUNT - 1 : 1)) % ROW_COUNT;
+			UI::PlayUISound(UI::UISound::SELECT);
+		} else {
+			Change(sel_, dir == DIR_LEFT ? -1 : 1, false);
+		}
+	}
+
+	void Resume() {
+		g_Config.Save("M33QuickMenu");
+		UI::PlayUISound(UI::UISound::BACK);
+		TriggerFinish(DR_BACK);
+	}
+
+	void Activate() {
+		if (cheatsPage_) {
+			if (cheatSel_ == 0) {
+				ImportCheats();
+			} else {
+				const bool was = M33Cheats::Items()[cheatSel_ - 1].enabled;
+				if (M33Cheats::Toggle(cheatSel_ - 1))
+					UI::PlayUISound(was ? UI::UISound::TOGGLE_OFF : UI::UISound::TOGGLE_ON);
+			}
+			return;
+		}
+		Change(sel_, 1, true);
+	}
+
+	void ImportCheats() {
+		auto sy = GetI18NCategory(I18NCat::SYSTEM);
+		if (!M33Cheats::DatabaseExists()) {
+			if (!M33Cheats::Downloading()) {
+				status_ = M33T("Downloading the cheat database...");
+				M33Cheats::DownloadDatabase([this](bool ok) {
+					status_ = ok ? "" : M33T("Couldn't download the cheat database");
+					if (ok)
+						ImportCheats();
+				});
+			}
+			return;
+		}
+		const int n = M33Cheats::ImportFromDatabase();
+		status_ = n > 0 ? "" : (n == 0 ? M33T("No more cheats for this game in the database") : M33T("The cheat database couldn't be read"));
+		UI::PlayUISound(UI::UISound::CONFIRM);
+	}
+
+	// A row's action: Cross (activate) or Left / Right (delta)
+	void Change(int row, int delta, bool activate) {
+		const int slots = std::max(1, g_Config.iSaveStateSlotCount);
+		switch (row) {
+		case ROW_RESUME:
+			if (activate)
+				Resume();
+			break;
+		case ROW_SAVE:
+		case ROW_LOAD:
+			if (!activate) {
+				slot_ = (slot_ + delta + slots) % slots;
+				g_Config.iCurrentStateSlot = slot_;
+				UI::PlayUISound(UI::UISound::SELECT);
+			} else if (row == ROW_SAVE) {
+				SaveState::SaveSlot(statePrefix_, slot_, &ShowMessageAfterSaveStateAction);
+				g_Config.iCurrentStateSlot = slot_;
+				UI::PlayUISound(UI::UISound::CONFIRM);
+				TriggerFinish(DR_BACK);
+			} else if (SaveState::HasSaveInSlot(statePrefix_, slot_)) {
+				SaveState::LoadSlot(statePrefix_, slot_, &ShowMessageAfterSaveStateAction);
+				g_Config.iCurrentStateSlot = slot_;
+				UI::PlayUISound(UI::UISound::CONFIRM);
+				TriggerFinish(DR_BACK);
+			}
+			break;
+		case ROW_FRAMEGEN:
+			g_Config.bM33FrameGen = !g_Config.bM33FrameGen;
+			UI::PlayUISound(g_Config.bM33FrameGen ? UI::UISound::TOGGLE_ON : UI::UISound::TOGGLE_OFF);
+			break;
+		case ROW_REWIND:
+			g_Config.bM33Rewind = !g_Config.bM33Rewind;
+			UI::PlayUISound(g_Config.bM33Rewind ? UI::UISound::TOGGLE_ON : UI::UISound::TOGGLE_OFF);
+			break;
+		case ROW_CHEATS:
+			if (activate) {
+				M33Cheats::Load();
+				cheatsPage_ = true;
+				cheatSel_ = M33Cheats::Items().empty() ? 0 : 1;
+				while (cheatSel_ > 0 && cheatSel_ <= (int)M33Cheats::Items().size() && M33Cheats::Items()[cheatSel_ - 1].header)
+					cheatSel_ = (cheatSel_ + 1) % CheatRows();
+				UI::PlayUISound(UI::UISound::CONFIRM);
+			}
+			break;
+		case ROW_RESOLUTION: {
+			int res = g_Config.iInternalResolution;
+			res = std::clamp(res + delta, 1, 8);
+			if (activate && delta > 0 && g_Config.iInternalResolution == 8)
+				res = 1;
+			if (res != g_Config.iInternalResolution) {
+				g_Config.iInternalResolution = res;
+				System_PostUIMessage(UIMessage::GPU_RENDER_RESIZED);
+				UI::PlayUISound(UI::UISound::SELECT);
+			}
+			break;
+		}
+		case ROW_VOLUME: {
+			int v = g_Config.iGameVolume;
+			v = std::clamp(v + delta * 10, (int)VOLUME_OFF, (int)VOLUMEHI_FULL);
+			if (activate && delta > 0 && g_Config.iGameVolume == VOLUMEHI_FULL)
+				v = VOLUME_OFF;
+			g_Config.iGameVolume = v;
+			UI::PlayUISound(UI::UISound::SELECT);
+			break;
+		}
+		case ROW_COUNTER: {
+			// Off, FPS, Speed, both
+			const int fps = (int)ShowStatusFlags::FPS_COUNTER, speed = (int)ShowStatusFlags::SPEED_COUNTER;
+			const int states[4] = { 0, fps, speed, fps | speed };
+			int i = 0;
+			for (int k = 0; k < 4; k++)
+				if ((g_Config.iShowStatusFlags & (fps | speed)) == states[k])
+					i = k;
+			i = (i + delta + 4) % 4;
+			g_Config.iShowStatusFlags = (g_Config.iShowStatusFlags & ~(fps | speed)) | states[i];
+			UI::PlayUISound(UI::UISound::SELECT);
+			break;
+		}
+		case ROW_SETTINGS:
+			if (activate) {
+				UI::PlayUISound(UI::UISound::CONFIRM);
+				screenManager()->push(new GameSettingsScreen(gamePath_));
+			}
+			break;
+		case ROW_DISPLAY:
+			if (activate) {
+				UI::PlayUISound(UI::UISound::CONFIRM);
+				screenManager()->push(new DisplayLayoutScreen(gamePath_));
+			}
+			break;
+		case ROW_RESTART:
+			if (activate) {
+				g_Config.Save("M33QuickMenu");
+				System_PostUIMessage(UIMessage::REQUEST_GAME_RESET);
+				TriggerFinish(DR_BACK);
+			}
+			break;
+		case ROW_EXIT:
+			if (activate) {
+				g_Config.Save("M33QuickMenu");
+				UI::PlayUISound(UI::UISound::BACK);
+				if (g_Config.bPauseMenuExitsEmulator)
+					System_ExitApp();
+				else
+					TriggerFinish(DR_OK);  // back to M33's game list
+			}
+			break;
+		}
+	}
+
+	std::string ValueOf(int row) const {
+		switch (row) {
+		case ROW_SAVE:
+			return StringFromFormat(M33T("Slot %d"), slot_ + 1);
+		case ROW_LOAD: {
+			if (!SaveState::HasSaveInSlot(statePrefix_, slot_))
+				return StringFromFormat(M33T("Slot %d: empty"), slot_ + 1);
+			return StringFromFormat(M33T("Slot %d"), slot_ + 1);
+		}
+		case ROW_REWIND:
+			return g_Config.bM33Rewind ? M33T("On") : M33T("Off");
+		case ROW_FRAMEGEN:
+			return g_Config.bM33FrameGen ? M33T("On (30 to 60)") : M33T("Off");
+		case ROW_CHEATS: {
+			const int n = M33Cheats::EnabledCount();
+			return n ? StringFromFormat(M33T("%d on"), n) : "";
+		}
+		case ROW_RESOLUTION:
+			return StringFromFormat("%dx  (%dx%d)", g_Config.iInternalResolution, 480 * g_Config.iInternalResolution, 272 * g_Config.iInternalResolution);
+		case ROW_VOLUME:
+			return StringFromFormat("%d", g_Config.iGameVolume);
+		case ROW_COUNTER: {
+			const bool fps = g_Config.iShowStatusFlags & (int)ShowStatusFlags::FPS_COUNTER;
+			const bool speed = g_Config.iShowStatusFlags & (int)ShowStatusFlags::SPEED_COUNTER;
+			return fps && speed ? M33T("FPS + Speed") : fps ? "FPS" : speed ? M33T("Speed") : M33T("Off");
+		}
+		default:
+			return "";
+		}
+	}
+
+	bool HasArrows(int row) const {
+		return row == ROW_SAVE || row == ROW_LOAD || row == ROW_REWIND || row == ROW_FRAMEGEN || row == ROW_RESOLUTION || row == ROW_VOLUME || row == ROW_COUNTER;
+	}
+
+	// drawing helpers: the atlas's white texel, for flat and gradient shapes
+	void Quad(DrawBuffer *db, float x1, float y1, float x2, float y2, uint32_t tl, uint32_t tr, uint32_t br, uint32_t bl) {
+		db->V(x1, y1, tl, u_, v_);
+		db->V(x2, y1, tr, u_, v_);
+		db->V(x2, y2, br, u_, v_);
+		db->V(x1, y1, tl, u_, v_);
+		db->V(x2, y2, br, u_, v_);
+		db->V(x1, y2, bl, u_, v_);
+	}
+	void Tri(DrawBuffer *db, float ax, float ay, float bx, float by, float cx, float cy, uint32_t c) {
+		db->V(ax, ay, c, u_, v_);
+		db->V(bx, by, c, u_, v_);
+		db->V(cx, cy, c, u_, v_);
+	}
+	void Line(DrawBuffer *db, float x1, float y1, float x2, float y2, float t, uint32_t c) {
+		const float dx = x2 - x1, dy = y2 - y1, len = std::max(0.001f, std::sqrt(dx * dx + dy * dy));
+		const float nx = -dy / len * t * 0.5f, ny = dx / len * t * 0.5f;
+		db->V(x1 + nx, y1 + ny, c, u_, v_);
+		db->V(x2 + nx, y2 + ny, c, u_, v_);
+		db->V(x2 - nx, y2 - ny, c, u_, v_);
+		db->V(x1 + nx, y1 + ny, c, u_, v_);
+		db->V(x2 - nx, y2 - ny, c, u_, v_);
+		db->V(x1 - nx, y1 - ny, c, u_, v_);
+	}
+	void Arc(DrawBuffer *db, float cx, float cy, float r, float a0, float a1, float t, uint32_t c) {
+		const int n = 16;
+		for (int i = 0; i < n; i++) {
+			const float s = a0 + (a1 - a0) * i / n, e = a0 + (a1 - a0) * (i + 1) / n;
+			Line(db, cx + r * std::cos(s), cy + r * std::sin(s), cx + r * std::cos(e), cy + r * std::sin(e), t, c);
+		}
+	}
+	void RectLine(DrawBuffer *db, float x1, float y1, float x2, float y2, float t, uint32_t c) {
+		Quad(db, x1, y1, x2, y1 + t, c, c, c, c);
+		Quad(db, x1, y2 - t, x2, y2, c, c, c, c);
+		Quad(db, x1, y1, x1 + t, y2, c, c, c, c);
+		Quad(db, x2 - t, y1, x2, y2, c, c, c, c);
+	}
+	void Icon(DrawBuffer *db, int row, float cx, float cy, float s, uint32_t c);
+	enum Glyph { GLYPH_CROSS, GLYPH_CIRCLE, GLYPH_DPAD };
+	// A DualShock 4 button as on the pad: a dark round key with its symbol in its colour (blue cross,
+	// red circle); the D-pad as its cross of four arrow keys. Centred on (cx, cy), radius r.
+	void ButtonGlyph(DrawBuffer *db, Glyph glyph, float cx, float cy, float r, float a) {
+		if (glyph == GLYPH_DPAD) {
+			const float w = r * 0.62f, l = r * 1.0f;
+			const uint32_t key = Col(0x2A2F3A, 0.95f * a), edge = Col(0xC8CCD6, 0.9f * a), arrow = Col(0xE8EAF0, a);
+			// the cross, outlined
+			Quad(db, cx - w * 0.5f - 1.2f, cy - l - 1.2f, cx + w * 0.5f + 1.2f, cy + l + 1.2f, edge, edge, edge, edge);
+			Quad(db, cx - l - 1.2f, cy - w * 0.5f - 1.2f, cx + l + 1.2f, cy + w * 0.5f + 1.2f, edge, edge, edge, edge);
+			Quad(db, cx - w * 0.5f, cy - l, cx + w * 0.5f, cy + l, key, key, key, key);
+			Quad(db, cx - l, cy - w * 0.5f, cx + l, cy + w * 0.5f, key, key, key, key);
+			const float t = w * 0.28f, o = l * 0.72f, d = l * 0.38f;
+			Tri(db, cx, cy - o, cx - t, cy - d, cx + t, cy - d, arrow);
+			Tri(db, cx, cy + o, cx - t, cy + d, cx + t, cy + d, arrow);
+			Tri(db, cx - o, cy, cx - d, cy - t, cx - d, cy + t, arrow);
+			Tri(db, cx + o, cy, cx + d, cy - t, cx + d, cy + t, arrow);
+			return;
+		}
+		db->FillCircle(cx, cy, r + 1.5f, 32, Col(0xC8CCD6, 0.9f * a));
+		db->FillCircle(cx, cy, r, 32, Col(0x1E222B, 0.97f * a));
+		const float t = std::max(2.0f, r * 0.17f);
+		if (glyph == GLYPH_CROSS) {
+			const uint32_t blue = Col(0x7DB4F0, a);
+			const float e = r * 0.42f;
+			Line(db, cx - e, cy - e, cx + e, cy + e, t, blue);
+			Line(db, cx - e, cy + e, cx + e, cy - e, t, blue);
+		} else {
+			Arc(db, cx, cy, r * 0.48f, 0.0f, 6.2832f, t, Col(0xFF6B6B, a));
+		}
+	}
+	void Text(UIContext &dc, const std::string &text, float x, float y, float px, uint32_t color, int align = ALIGN_LEFT | ALIGN_TOP) {
+		dc.SetFontScale(px / fontPx_, px / fontPx_);
+		dc.DrawText(text, x, y, color, align);
+	}
+	float TextW(UIContext &dc, const std::string &text, float px) {
+		float w = 0, h = 0;
+		dc.MeasureText(dc.GetTheme().uiFont, px / fontPx_, px / fontPx_, text, &w, &h);
+		return w;
+	}
+	void DrawMain(UIContext &dc, DrawBuffer *db, float x0, float right, float W, float H, float k, float a, double now);
+	void DrawStateCard(UIContext &dc, DrawBuffer *db, float right, float W, float H, float k, float a);
+	// The picture PPSSPP saved with the slot's state (its .jpg), as a texture; reloaded when the slot or its date changes.
+	Draw::Texture *StatePicture(Draw::DrawContext *draw);
+	void DrawCheats(UIContext &dc, DrawBuffer *db, float x0, float right, float W, float H, float k, float a);
+
+	Path gamePath_;
+	std::string statePrefix_, title_, status_;
+	int slot_ = 0;
+	int sel_ = 0;
+	bool cheatsPage_ = false;
+	int cheatSel_ = 0;
+	float cheatScroll_ = 0.0f;
+	int held_ = 0, stickX_ = 0, stickY_ = 0;
+	double repeatAt_ = 0.0, opened_ = 0.0, lastTime_ = 0.0;
+	float slide_ = 0.0f, highlight_ = 0.0f, highlightVel_ = 0.0f;
+	float u_ = 0.0f, v_ = 0.0f, fontPx_ = 1.0f;
+	float card_ = 0.0f;
+	Draw::Texture *statePic_ = nullptr;
+	std::string statePicKey_;
+public:
+	~M33QuickMenu() override {
+		if (statePic_)
+			statePic_->Release();
+	}
+};
+
+Draw::Texture *M33QuickMenu::StatePicture(Draw::DrawContext *draw) {
+	const std::string date = SaveState::HasSaveInSlot(statePrefix_, slot_) ? SaveState::GetSlotDateAsString(statePrefix_, slot_) : std::string();
+	const std::string key = std::to_string(slot_) + "|" + date;
+	if (key == statePicKey_)
+		return statePic_;
+	statePicKey_ = key;
+	if (statePic_) {
+		statePic_->Release();
+		statePic_ = nullptr;
+	}
+	if (date.empty())
+		return nullptr;
+	std::string data;
+	if (File::ReadBinaryFileToString(SaveState::GenerateSaveSlotPath(statePrefix_, slot_, SaveState::SCREENSHOT_EXTENSION), &data) && !data.empty())
+		statePic_ = CreateTextureFromFileData(draw, (const uint8_t *)data.data(), data.size(), ImageFileType::DETECT, false, "M33StatePicture");
+	return statePic_;
+}
+
+// A row's icon, drawn with lines and shapes (as Crema's), centred on (cx, cy), size s
+void M33QuickMenu::Icon(DrawBuffer *db, int row, float cx, float cy, float s, uint32_t c) {
+	const float h = s * 0.5f, t = std::max(2.0f, s * 0.09f);
+	constexpr float kPi = 3.14159265f;
+	switch (row) {
+	case ROW_RESUME:
+		Tri(db, cx - h * 0.6f, cy - h * 0.8f, cx + h * 0.8f, cy, cx - h * 0.6f, cy + h * 0.8f, c);
+		break;
+	case ROW_SAVE:  // a floppy
+		RectLine(db, cx - h * 0.8f, cy - h * 0.8f, cx + h * 0.8f, cy + h * 0.8f, t, c);
+		Quad(db, cx - h * 0.45f, cy - h * 0.8f, cx + h * 0.35f, cy - h * 0.3f, c, c, c, c);
+		break;
+	case ROW_LOAD:  // a folder
+		RectLine(db, cx - h * 0.9f, cy - h * 0.45f, cx + h * 0.9f, cy + h * 0.7f, t, c);
+		Quad(db, cx - h * 0.9f, cy - h * 0.7f, cx - h * 0.2f, cy - h * 0.45f, c, c, c, c);
+		break;
+	case ROW_FRAMEGEN:  // two frames, one between
+		RectLine(db, cx - h, cy - h * 0.55f, cx - h * 0.15f, cy + h * 0.55f, t, c);
+		RectLine(db, cx + h * 0.15f, cy - h * 0.55f, cx + h, cy + h * 0.55f, t, c);
+		Quad(db, cx - h * 0.08f, cy - h * 0.3f, cx + h * 0.08f, cy + h * 0.3f, c, c, c, c);
+		break;
+	case ROW_REWIND:  // two arrows back
+		Tri(db, cx - h, cy, cx, cy - h * 0.6f, cx, cy + h * 0.6f, c);
+		Tri(db, cx, cy, cx + h, cy - h * 0.6f, cx + h, cy + h * 0.6f, c);
+		break;
+	case ROW_CHEATS:  // a star
+		for (int i = 0; i < 5; i++) {
+			const float a1 = -kPi / 2 + i * 2 * kPi / 5, a2 = a1 + 2 * kPi / 5 * 2;
+			Line(db, cx + h * std::cos(a1), cy + h * std::sin(a1), cx + h * std::cos(a2), cy + h * std::sin(a2), t, c);
+		}
+		break;
+	case ROW_RESOLUTION:  // a screen
+	case ROW_DISPLAY:
+		RectLine(db, cx - h, cy - h * 0.65f, cx + h, cy + h * 0.5f, t, c);
+		Line(db, cx - h * 0.4f, cy + h * 0.85f, cx + h * 0.4f, cy + h * 0.85f, t, c);
+		if (row == ROW_DISPLAY)
+			Tri(db, cx - h * 0.3f, cy + h * 0.25f, cx + h * 0.4f, cy + h * 0.25f, cx + h * 0.4f, cy - h * 0.4f, c);
+		break;
+	case ROW_VOLUME:
+		Quad(db, cx - h, cy - h * 0.3f, cx - h * 0.55f, cy + h * 0.3f, c, c, c, c);
+		Tri(db, cx - h * 0.6f, cy - h * 0.3f, cx - h * 0.1f, cy - h * 0.8f, cx - h * 0.1f, cy + h * 0.8f, c);
+		Tri(db, cx - h * 0.6f, cy - h * 0.3f, cx - h * 0.1f, cy + h * 0.8f, cx - h * 0.6f, cy + h * 0.3f, c);
+		Arc(db, cx - h * 0.1f, cy, h * 0.55f, -0.8f, 0.8f, t, c);
+		Arc(db, cx - h * 0.1f, cy, h * 0.95f, -0.8f, 0.8f, t, c);
+		break;
+	case ROW_COUNTER:
+		for (int i = 0; i < 3; i++) {
+			const float bx = cx - h + i * h * 0.75f, bh = h * (0.6f + 0.55f * i);
+			Quad(db, bx, cy + h - bh, bx + h * 0.45f, cy + h, c, c, c, c);
+		}
+		break;
+	case ROW_SETTINGS:  // a gear
+		Arc(db, cx, cy, h * 0.5f, 0, 2 * kPi, t, c);
+		for (int i = 0; i < 8; i++) {
+			const float an = i * kPi / 4;
+			Line(db, cx + h * 0.55f * std::cos(an), cy + h * 0.55f * std::sin(an), cx + h * 0.95f * std::cos(an), cy + h * 0.95f * std::sin(an), t * 1.6f, c);
+		}
+		break;
+	case ROW_RESTART:
+		Arc(db, cx, cy, h * 0.8f, 0.6f, 5.6f, t, c);
+		Tri(db, cx + h * 0.95f, cy - h * 0.15f, cx + h * 0.35f, cy - h * 0.15f, cx + h * 0.7f, cy + h * 0.4f, c);
+		break;
+	case ROW_EXIT:
+		Arc(db, cx, cy, h * 0.8f, -kPi / 2 + 0.6f, 3 * kPi / 2 - 0.6f, t, c);
+		Line(db, cx, cy - h, cx, cy - h * 0.1f, t, c);
+		break;
+	}
+}
+
+void M33QuickMenu::DrawForeground(UIContext &dc) {
+	const double now = time_now_d();
+	const float dt = (float)std::clamp(now - lastTime_, 0.0, 0.1);
+	lastTime_ = now;
+	slide_ += (1.0f - slide_) * (1.0f - std::exp(-16.0f * dt));
+	// the highlight glides (a spring) to the selected row
+	const float target = cheatsPage_ ? 0.0f : (float)sel_;
+	highlightVel_ += (target - highlight_) * 170.0f * dt - highlightVel_ * 26.0f * dt;
+	highlight_ += highlightVel_ * dt;
+
+	const Bounds &b = dc.GetBounds();
+	const float W = b.w, H = b.h, k = H / 1080.0f;  // laid out on a 1080p screen, like Crema's
+	const float a = slide_;
+	DrawBuffer *db = dc.Draw();
+	const AtlasImage *white = db->GetAtlas() ? db->GetAtlas()->getImage(dc.GetTheme().whiteImage) : nullptr;
+	if (!white)
+		return;
+	u_ = (white->u1 + white->u2) * 0.5f;
+	v_ = (white->v1 + white->v2) * 0.5f;
+	{
+		float w = 0, h = 0;
+		dc.MeasureText(dc.GetTheme().uiFont, 1.0f, 1.0f, "Ag", &w, &h);
+		fontPx_ = std::max(1.0f, h);
+	}
+	dc.Begin();
+	dc.SetFontStyle(dc.GetTheme().uiFont);
+
+	// the paused game behind a dark panel sliding in from the left, its edge a glowing line
+	const float panelW = std::max(820.0f * k, W * 0.42f);
+	const float x0 = -panelW * 0.25f * (1.0f - a), right = x0 + panelW;
+	Quad(db, 0, 0, W, H, Col(0, 0.30f * a), Col(0, 0.30f * a), Col(0, 0.30f * a), Col(0, 0.30f * a));
+	const uint32_t dark = Col(0x040812, 0.93f * a), mid = Col(0x040812, 0.62f * a), clear = Col(0x040812, 0.0f);
+	Quad(db, 0, 0, right, H, dark, mid, mid, dark);
+	Quad(db, right, 0, right + W * 0.15f, H, mid, clear, clear, mid);
+	Quad(db, right - 2 * k, 0, right, H, Col(ACCENT, 0.6f * a), Col(ACCENT, 0.6f * a), Col(ACCENT, 0.6f * a), Col(ACCENT, 0.6f * a));
+
+	if (cheatsPage_)
+		DrawCheats(dc, db, x0, right, W, H, k, a);
+	else
+		DrawMain(dc, db, x0, right, W, H, k, a, now);
+
+	// the clock, top right
+	{
+		const time_t t = time(nullptr);
+		char clock[16];
+		strftime(clock, sizeof(clock), "%H:%M", localtime(&t));
+		Text(dc, clock, W - 60 * k, 50 * k, 30 * k, Col(TEXT, 0.9f * a), ALIGN_RIGHT | ALIGN_TOP);
+	}
+	// the buttons
+	{
+		float bx = x0 + 70 * k;
+		const float by = H - 80 * k;
+		auto label = [&](const char *text) {
+			Text(dc, text, bx, by, 24 * k, Col(TEXT, 0.85f * a), ALIGN_LEFT | ALIGN_VCENTER);
+			bx += TextW(dc, text, 24 * k) + 36 * k;
+		};
+		ButtonGlyph(db, GLYPH_CROSS, bx + 17 * k, by, 17 * k, a);
+		bx += 44 * k;
+		label(cheatsPage_ ? M33T("On / Off") : M33T("Select"));
+		if (!cheatsPage_) {
+			ButtonGlyph(db, GLYPH_DPAD, bx + 17 * k, by, 17 * k, a);
+			bx += 44 * k;
+			label(M33T("Change"));
+		}
+		ButtonGlyph(db, GLYPH_CIRCLE, bx + 17 * k, by, 17 * k, a);
+		bx += 44 * k;
+		label(M33T("Back"));
+	}
+	dc.SetFontScale(1.0f, 1.0f);
+	dc.Flush();
+}
+
+void M33QuickMenu::DrawMain(UIContext &dc, DrawBuffer *db, float x0, float right, float W, float H, float k, float a, double now) {
+	const float lx = x0 + 70 * k;
+	Text(dc, "M33", lx, 78 * k, 44 * k, Col(TEXT, a));
+	// the tag: the game is paused behind
+	const char *tagText = M33T("QUICK MENU");
+	const float tagW = TextW(dc, tagText, 20 * k) + 28 * k;
+	const float pulse = 0.75f + 0.25f * std::sin((float)now * 3.0f);
+	const float tagX = lx + TextW(dc, "M33", 44 * k) + 20 * k;
+	const uint32_t tagCol = Col(ACCENT, 0.9f * a * pulse);
+	Quad(db, tagX, 92 * k, tagX + tagW, 122 * k, tagCol, tagCol, tagCol, tagCol);
+	Text(dc, tagText, tagX + 14 * k, 107 * k, 20 * k, Col(TEXT, a), ALIGN_LEFT | ALIGN_VCENTER);
+	std::string name = title_;
+	while (!name.empty() && TextW(dc, name, 30 * k) > right - lx - 70 * k)
+		name.pop_back();
+	Text(dc, name, lx, 140 * k, 30 * k, Col(ACCENT, a));
+
+	// rows: a gap before Restart and Exit
+	const float ROW_H = 60 * k, TOP = 205 * k, GAP = 22 * k;
+	auto rowY = [&](float r) { return TOP + r * ROW_H + (r >= ROW_RESTART ? GAP : 0.0f); };
+	const float hy = rowY(std::clamp(highlight_, 0.0f, (float)ROW_COUNT - 1));
+	const float hx0 = lx - 30 * k, hx1 = right - 40 * k;
+	Quad(db, hx0, hy - 6 * k, hx1, hy + ROW_H - 12 * k, Col(ACCENT, 0.55f * a), Col(ACCENT, 0.12f * a), Col(ACCENT, 0.12f * a), Col(ACCENT, 0.55f * a));
+	Quad(db, hx0, hy - 6 * k, hx0 + 4 * k, hy + ROW_H - 12 * k, Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a));
+	const float sepY = rowY((float)ROW_RESTART) - GAP * 0.6f;
+	Quad(db, lx - 10 * k, sepY, hx1, sepY + 1.5f * k, Col(ACCENT, 0.35f * a), Col(ACCENT, 0.35f * a), Col(ACCENT, 0.35f * a), Col(ACCENT, 0.35f * a));
+	for (int row = 0; row < ROW_COUNT; row++) {
+		const float y = rowY((float)row);
+		const bool sel = row == sel_;
+		const float alpha = a * (sel ? 1.0f : 0.8f);
+		Icon(db, row, lx + 12 * k, y + 22 * k, 30 * k, Col(TEXT, alpha));
+		Text(dc, M33T(kRowLabels[row]), lx + 50 * k, y + 22 * k, 30 * k, Col(TEXT, alpha), ALIGN_LEFT | ALIGN_VCENTER);
+		const std::string value = ValueOf(row);
+		if (value.empty())
+			continue;
+		const bool arrows = sel && HasArrows(row);
+		const float tw = TextW(dc, value, 27 * k);
+		const float vx = hx1 - 24 * k - tw - (arrows ? 22 * k : 0.0f);
+		Text(dc, value, vx, y + 22 * k, 27 * k, Col(TEXT, 0.9f * alpha), ALIGN_LEFT | ALIGN_VCENTER);
+		if (arrows) {
+			const float cy = y + 22 * k, s = 7 * k, l = vx - 26 * k, r = hx1 - 14 * k;
+			Tri(db, l, cy, l + s, cy - s, l + s, cy + s, Col(TEXT, 0.9f * alpha));
+			Tri(db, r, cy, r - s, cy - s, r - s, cy + s, Col(TEXT, 0.9f * alpha));
+		}
+	}
+	if (!status_.empty())
+		Text(dc, status_, lx, H - 130 * k, 24 * k, Col(WARN, a));
+	DrawStateCard(dc, db, right, W, H, k, a);
+}
+
+void M33QuickMenu::DrawStateCard(UIContext &dc, DrawBuffer *db, float right, float W, float H, float k, float a) {
+	// fades in beside the panel while Save or Load State is selected
+	const float want = sel_ == ROW_SAVE || sel_ == ROW_LOAD ? 1.0f : 0.0f;
+	card_ += (want - card_) * 0.25f;
+	const float c = card_ * a;
+	if (c < 0.02f)
+		return;
+	const float cw = std::min(W * 0.36f, W - right - 120 * k), ch = cw * 272.0f / 480.0f;
+	const float ax = right + (W - right - cw) * 0.5f, ay = H * 0.27f, bx = ax + cw, by = ay + ch;
+	const uint32_t shadow = Col(0, 0.43f * c), back = Col(0x0A0E18, 0.86f * c);
+	Quad(db, ax + 6 * k, ay + 8 * k, bx + 6 * k, by + 8 * k, shadow, shadow, shadow, shadow);
+	Quad(db, ax, ay, bx, by, back, back, back, back);
+	Draw::Texture *pic = StatePicture(dc.GetDrawContext());
+	if (pic) {
+		dc.Flush();
+		dc.GetDrawContext()->BindTexture(0, pic);
+		db->DrawTexRect(Bounds(ax, ay, cw, ch), 0, 0, 1, 1, Col(0xFFFFFF, c));
+		dc.Flush();
+		dc.RebindTexture();
+	} else {
+		Text(dc, M33T("Empty"), (ax + bx) * 0.5f, (ay + by) * 0.5f, 30 * k, Col(TEXT, 0.8f * c), ALIGN_CENTER);
+	}
+	RectLine(db, ax, ay, bx, by, 1.5f * k, Col(0xFFFFFF, 0.31f * c));
+	// the slots as dots, the current one bigger
+	const int slots = std::max(1, g_Config.iSaveStateSlotCount);
+	for (int i = 0; i < slots; i++) {
+		const float dx = (ax + bx) * 0.5f + (i - (slots - 1) * 0.5f) * 24 * k, dy = by + 32 * k;
+		const bool cur = i == slot_;
+		db->FillCircle(dx, dy, (cur ? 6.5f : 4.0f) * k, 12, Col(0xFFFFFF, (cur ? 1.0f : 0.43f) * c));
+	}
+	const std::string date = SaveState::HasSaveInSlot(statePrefix_, slot_) ? SaveState::GetSlotDateAsString(statePrefix_, slot_) : std::string(M33T("Empty"));
+	Text(dc, StringFromFormat("Slot %d   ", slot_ + 1) + date, ax, by + 60 * k, 26 * k, Col(TEXT, c));
+}
+
+void M33QuickMenu::DrawCheats(UIContext &dc, DrawBuffer *db, float x0, float right, float W, float H, float k, float a) {
+	const float lx = x0 + 70 * k;
+	Text(dc, M33T("Cheats"), lx, 78 * k, 44 * k, Col(TEXT, a));
+	std::string name = title_;
+	while (!name.empty() && TextW(dc, name, 26 * k) > right - lx - 70 * k)
+		name.pop_back();
+	Text(dc, name, lx, 140 * k, 26 * k, Col(ACCENT, a));
+
+	const auto &items = M33Cheats::Items();
+	const int rows = (int)items.size() + 1;
+	const float ROW_H = 50 * k, TOP = 200 * k, BOTTOM = H - 150 * k;
+	const int visible = std::max(1, (int)((BOTTOM - TOP) / ROW_H));
+	// keep the selection in view
+	const float want = std::clamp((float)cheatSel_ - visible / 2.0f, 0.0f, std::max(0.0f, (float)rows - visible));
+	cheatScroll_ += (want - cheatScroll_) * 0.25f;
+	const float hx0 = lx - 30 * k, hx1 = right - 40 * k;
+	for (int r = 0; r < rows; r++) {
+		const float y = TOP + (r - cheatScroll_) * ROW_H;
+		if (y < TOP - ROW_H * 0.5f || y > BOTTOM)
+			continue;
+		const bool sel = r == cheatSel_;
+		if (sel) {
+			Quad(db, hx0, y - 4 * k, hx1, y + ROW_H - 8 * k, Col(ACCENT, 0.55f * a), Col(ACCENT, 0.12f * a), Col(ACCENT, 0.12f * a), Col(ACCENT, 0.55f * a));
+			Quad(db, hx0, y - 4 * k, hx0 + 4 * k, y + ROW_H - 8 * k, Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a), Col(0xFFFFFF, 0.9f * a));
+		}
+		const float cy = y + 19 * k;
+		if (r == 0) {
+			std::string label = M33Cheats::Downloading() ? M33T("Downloading the cheat database...") :
+				(M33Cheats::DatabaseExists() ? M33T("Get this game's cheats from the database") : M33T("Download the cheat database"));
+			Text(dc, label, lx, cy, 26 * k, Col(sel ? TEXT : ACCENT, a), ALIGN_LEFT | ALIGN_VCENTER);
+			continue;
+		}
+		const auto &item = items[r - 1];
+		if (item.header) {
+			Text(dc, item.name, lx, cy, 22 * k, Col(ACCENT, 0.85f * a), ALIGN_LEFT | ALIGN_VCENTER);
+			continue;
+		}
+		std::string text = item.name;
+		const float valueW = 70 * k;
+		while (!text.empty() && TextW(dc, text, 26 * k) > hx1 - lx - valueW - 30 * k)
+			text.pop_back();
+		Text(dc, text, lx + 10 * k, cy, 26 * k, Col(TEXT, a * (sel ? 1.0f : 0.8f)), ALIGN_LEFT | ALIGN_VCENTER);
+		Text(dc, item.enabled ? M33T("On") : M33T("Off"), hx1 - 24 * k, cy, 24 * k, Col(item.enabled ? ACCENT : TEXT, a * (item.enabled ? 1.0f : 0.6f)), ALIGN_RIGHT | ALIGN_VCENTER);
+	}
+	if (items.empty())
+		Text(dc, M33T("No cheats for this game yet"), lx, TOP + ROW_H * 1.5f, 24 * k, Col(TEXT, 0.6f * a));
+	if (!status_.empty())
+		Text(dc, status_, lx, H - 130 * k, 24 * k, Col(WARN, a));
+}
+
+}  // namespace
+
+UIScreen *M33_CreatePauseMenu(const Path &gamePath, bool bootPending) {
+	// PPSSPP's own while booting, and in the XMB (its saves and settings aren't a game's)
+	if (bootPending || PSP_CoreParameter().fileToStart.GetFilename() == "vshmain.prx")
+		return new GamePauseScreen(gamePath, bootPending);
+	return new M33QuickMenu(gamePath);
+}
