new file mode 100644
index 0000000..60da73e
--- /dev/null
+++ b/ps4/PS4Audio.cpp
@@ -0,0 +1,137 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: audio through sceAudioOut (as Resonance's audio backend).
+//
+// An output thread asks PPSSPP's mixer (NativeMix, which resamples the PSP's 44.1 kHz itself) for
+// one 256-frame grain of 48 kHz stereo at a time and hands it to the main port.
+// sceAudioOutOutput blocks until the previous grain is playing, which paces the thread.
+
+#include <orbis/AudioOut.h>
+#include <orbis/libkernel.h>
+
+#include <atomic>
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "Common/Log.h"
+#include "Common/System/NativeApp.h"
+#include "Common/Thread/ThreadUtil.h"
+#include "ps4/PS4Audio.h"
+#include "ps4/PS4Rewind.h"
+
+namespace PS4Audio {
+
+namespace {
+
+constexpr int32_t kSystemUser = 0xFF;    // the main port, whoever is signed in
+constexpr int32_t kVolumeMax = 32768;    // SCE_AUDIO_VOLUME_0DB
+// libkernel declares these without parameters
+using SetAffinityFn = int32_t (*)(OrbisPthread, uint64_t);
+using SetPrioFn = int32_t (*)(OrbisPthread, int);
+
+int32_t g_port = -1;
+std::atomic<bool> g_running{ false };
+std::thread g_thread;
+
+std::mutex g_overlayLock;
+std::vector<int16_t> g_overlay;  // interleaved stereo
+size_t g_overlayPos = 0;
+
+void MixOverlay(int16_t *out, int frames) {
+	std::lock_guard<std::mutex> guard(g_overlayLock);
+	if (g_overlayPos >= g_overlay.size())
+		return;
+	const size_t n = std::min(g_overlay.size() - g_overlayPos, (size_t)frames * 2);
+	for (size_t i = 0; i < n; i++)
+		out[i] = (int16_t)std::clamp((int)out[i] + (int)g_overlay[g_overlayPos + i], -32768, 32767);
+	g_overlayPos += n;
+}
+
+void OutputLoop() {
+	SetCurrentThreadName("PS4AudioOut");
+	// A thread inherits its creator's cores: take all of the app's, and a priority above the
+	// emulation's so a slow frame doesn't make the sound crackle.
+	const OrbisPthread self = scePthreadSelf();
+	((SetAffinityFn)&scePthreadSetaffinity)(self, 0x3F);
+	((SetPrioFn)&scePthreadSetprio)(self, 400);
+
+	alignas(32) int16_t grains[2][kGrainFrames * 2];
+	int current = 0;
+	while (g_running) {
+		int16_t *out = grains[current];
+		NativeMix(out, kGrainFrames, kSampleRate, nullptr);
+		if (M33Rewind_Active())  // (the frames shown going back would only stutter)
+			memset(out, 0, sizeof(grains[0]));
+		MixOverlay(out, kGrainFrames);
+		sceAudioOutOutput(g_port, out);
+		current ^= 1;
+	}
+	sceAudioOutOutput(g_port, nullptr);  // wait for the last grain
+}
+
+}  // namespace
+
+void PlayOverlay(std::vector<int16_t> pcm) {
+	std::lock_guard<std::mutex> guard(g_overlayLock);
+	g_overlay = std::move(pcm);
+	g_overlayPos = 0;
+}
+
+void StopOverlay() {
+	std::lock_guard<std::mutex> guard(g_overlayLock);
+	g_overlay.clear();
+	g_overlay.shrink_to_fit();
+	g_overlayPos = 0;
+}
+
+bool Start() {
+	if (g_running)
+		return true;
+	const int32_t result = sceAudioOutInit();
+	// already initialized is fine
+	if (result != 0 && result != (int32_t)0x8026000E) {
+		ERROR_LOG(Log::Audio, "PS4Audio: sceAudioOutInit failed: %08x", result);
+		return false;
+	}
+	g_port = sceAudioOutOpen(kSystemUser, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, kGrainFrames, kSampleRate,
+			ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+	if (g_port < 0) {
+		ERROR_LOG(Log::Audio, "PS4Audio: sceAudioOutOpen failed: %08x", g_port);
+		return false;
+	}
+	int32_t volume[2] = { kVolumeMax, kVolumeMax };
+	sceAudioOutSetVolume(g_port, 0x3, volume);  // front left + right
+	g_running = true;
+	g_thread = std::thread(&OutputLoop);
+	INFO_LOG(Log::Audio, "PS4Audio: port %08x, %d frames at %d Hz", g_port, kGrainFrames, kSampleRate);
+	return true;
+}
+
+void Stop() {
+	if (!g_running)
+		return;
+	g_running = false;
+	if (g_thread.joinable())
+		g_thread.join();
+	if (g_port >= 0) {
+		sceAudioOutClose(g_port);
+		g_port = -1;
+	}
+}
+
+}  // namespace PS4Audio
