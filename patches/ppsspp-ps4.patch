diff --git a/ps4/PS4Pad.cpp b/ps4/PS4Pad.cpp
new file mode 100644
index 0000000..2438506
--- /dev/null
+++ b/ps4/PS4Pad.cpp
@@ -0,0 +1,273 @@
+// Copyright (c) 2026- PPSSPP Project.
+
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License 2.0 for more details.
+
+// A copy of the GPL 2.0 should have been included with the program.
+// If not, see http://www.gnu.org/licenses/
+
+// M33: DualShock 4 input through ScePad.
+//
+// Buttons are sent with the key codes of PPSSPP's generic pad mapping (DEFAULT_MAPPING_PAD, as
+// SDL's gamepads do), so the default controls work without setup:
+//   Cross/Circle/Square/Triangle = PSP buttons, D-pad, left stick = PSP stick, L1/R1 = L/R,
+//   OPTIONS = START, touchpad click = SELECT, L2 = PPSSPP's menu, R2 = fast-forward (analog),
+//   L3 + R3 together = PPSSPP's in-game menu too; right stick, L3, R3: free to map in Settings > Controls.
+
+#include <orbis/Pad.h>
+#include <orbis/UserService.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+#include "Common/Input/InputState.h"
+#include "Common/Input/KeyCodes.h"
+#include "Common/Log.h"
+#include "Common/System/NativeApp.h"
+#include "Core/KeyMap.h"
+#include "ps4/PS4Pad.h"
+
+namespace PS4Pad {
+
+namespace {
+
+constexpr int kMaxPads = 4;
+constexpr int kInvalidUser = -1;
+
+struct ButtonMap {
+	uint32_t bit;
+	InputKeyCode key;
+};
+
+const ButtonMap kButtons[] = {
+	{ ORBIS_PAD_BUTTON_CROSS, NKCODE_BUTTON_2 },
+	{ ORBIS_PAD_BUTTON_CIRCLE, NKCODE_BUTTON_3 },
+	{ ORBIS_PAD_BUTTON_SQUARE, NKCODE_BUTTON_4 },
+	{ ORBIS_PAD_BUTTON_TRIANGLE, NKCODE_BUTTON_1 },
+	{ ORBIS_PAD_BUTTON_UP, NKCODE_DPAD_UP },
+	{ ORBIS_PAD_BUTTON_DOWN, NKCODE_DPAD_DOWN },
+	{ ORBIS_PAD_BUTTON_LEFT, NKCODE_DPAD_LEFT },
+	{ ORBIS_PAD_BUTTON_RIGHT, NKCODE_DPAD_RIGHT },
+	{ ORBIS_PAD_BUTTON_L1, NKCODE_BUTTON_7 },
+	{ ORBIS_PAD_BUTTON_R1, NKCODE_BUTTON_8 },
+	{ ORBIS_PAD_BUTTON_OPTIONS, NKCODE_BUTTON_10 },
+	{ ORBIS_PAD_BUTTON_TOUCH_PAD, NKCODE_BUTTON_9 },
+	{ ORBIS_PAD_BUTTON_L3, NKCODE_BUTTON_THUMBL },
+	{ ORBIS_PAD_BUTTON_R3, NKCODE_BUTTON_THUMBR },
+};
+
+enum Axis { AX_LX, AX_LY, AX_RX, AX_RY, AX_L2, AX_R2, AX_COUNT };
+const InputAxis kAxisIds[AX_COUNT] = {
+	JOYSTICK_AXIS_X, JOYSTICK_AXIS_Y, JOYSTICK_AXIS_Z, JOYSTICK_AXIS_RZ,
+	JOYSTICK_AXIS_LTRIGGER, JOYSTICK_AXIS_RTRIGGER,
+};
+
+struct Pad {
+	int user = kInvalidUser;
+	int handle = -1;
+	uint32_t buttons = 0;
+	float axes[AX_COUNT]{};
+	bool menuCombo = false;  // L3 + R3 held
+};
+
+// L3 + R3 together: PPSSPP's in-game menu, as the key its default mapping pauses with (L2).
+constexpr uint32_t kMenuCombo = ORBIS_PAD_BUTTON_L3 | ORBIS_PAD_BUTTON_R3;
+constexpr InputKeyCode kMenuKey = NKCODE_BUTTON_L2;
+
+Pad g_pads[kMaxPads];
+std::mutex g_lock;
+int g_rescanCountdown = 0;
+std::atomic<int64_t> g_vibrateUntilMs{ 0 };
+bool g_vibrating = false;
+
+int64_t NowMs() {
+	return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+float Stick(uint8_t v) {
+	const float f = ((int)v - 128) / 127.0f;
+	return std::clamp(f, -1.0f, 1.0f);
+}
+
+float Trigger(uint8_t v) {
+	return v / 255.0f;
+}
+
+InputDeviceID DeviceFor(int slot) {
+	return (InputDeviceID)(DEVICE_ID_PAD_0 + slot);
+}
+
+void ReleaseAll(int slot) {
+	Pad &pad = g_pads[slot];
+	for (const ButtonMap &b : kButtons) {
+		if (pad.buttons & b.bit)
+			NativeKey(KeyInput(DeviceFor(slot), b.key, KeyInputFlags::UP));
+	}
+	if (pad.menuCombo) {
+		NativeKey(KeyInput(DeviceFor(slot), kMenuKey, KeyInputFlags::UP));
+		pad.menuCombo = false;
+	}
+	AxisInput axes[AX_COUNT];
+	for (int a = 0; a < AX_COUNT; a++) {
+		axes[a].deviceId = DeviceFor(slot);
+		axes[a].axisId = kAxisIds[a];
+		axes[a].value = 0.0f;
+	}
+	NativeAxis(axes, AX_COUNT);
+	pad.buttons = 0;
+	std::fill(std::begin(pad.axes), std::end(pad.axes), 0.0f);
+}
+
+// Opens a pad for every signed-in user that has none, closes the ones of users who left.
+void Rescan() {
+	OrbisUserServiceLoginUserIdList list{};
+	if (sceUserServiceGetLoginUserIdList(&list) != 0)
+		return;
+	auto signedIn = [&](int user) {
+		for (int i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++)
+			if (list.userId[i] == user)
+				return true;
+		return false;
+	};
+	for (int slot = 0; slot < kMaxPads; slot++) {
+		Pad &pad = g_pads[slot];
+		if (pad.handle >= 0 && !signedIn(pad.user)) {
+			ReleaseAll(slot);
+			scePadClose(pad.handle);
+			KeyMap::NotifyPadDisconnected(DeviceFor(slot));
+			INFO_LOG(Log::System, "PS4Pad: user %08x left, pad %d closed", pad.user, slot);
+			pad = Pad();
+		}
+	}
+	for (int i = 0; i < ORBIS_USER_SERVICE_MAX_LOGIN_USERS; i++) {
+		const int user = list.userId[i];
+		if (user == kInvalidUser || user == 0)
+			continue;
+		bool known = false;
+		for (const Pad &pad : g_pads)
+			known |= pad.user == user;
+		if (known)
+			continue;
+		for (int slot = 0; slot < kMaxPads; slot++) {
+			Pad &pad = g_pads[slot];
+			if (pad.handle >= 0)
+				continue;
+			const int handle = scePadOpen(user, ORBIS_PAD_PORT_TYPE_STANDARD, 0, nullptr);
+			if (handle < 0) {
+				// already open (another process) or no pad yet: try again at the next rescan
+				break;
+			}
+			pad.user = user;
+			pad.handle = handle;
+			char name[64];
+			snprintf(name, sizeof(name), "PS4: DualShock 4 (user %08x)", user);
+			KeyMap::NotifyPadConnected(DeviceFor(slot), name);
+			INFO_LOG(Log::System, "PS4Pad: user %08x on pad %d (handle %d)", user, slot, handle);
+			break;
+		}
+	}
+}
+
+void ReadPad(int slot) {
+	Pad &pad = g_pads[slot];
+	OrbisPadData data{};
+	if (scePadReadState(pad.handle, &data) != 0 || !data.connected) {
+		if (pad.buttons != 0)
+			ReleaseAll(slot);
+		return;
+	}
+	const InputDeviceID device = DeviceFor(slot);
+	const uint32_t changed = data.buttons ^ pad.buttons;
+	if (changed) {
+		for (const ButtonMap &b : kButtons) {
+			if (changed & b.bit)
+				NativeKey(KeyInput(device, b.key, (data.buttons & b.bit) ? KeyInputFlags::DOWN : KeyInputFlags::UP));
+		}
+		pad.buttons = data.buttons;
+	}
+	const bool combo = (data.buttons & kMenuCombo) == kMenuCombo;
+	if (combo != pad.menuCombo) {
+		pad.menuCombo = combo;
+		NativeKey(KeyInput(device, kMenuKey, combo ? KeyInputFlags::DOWN : KeyInputFlags::UP));
+	}
+
+	const float values[AX_COUNT] = {
+		Stick(data.leftStick.x), Stick(data.leftStick.y), Stick(data.rightStick.x), Stick(data.rightStick.y),
+		Trigger(data.analogButtons.l2), Trigger(data.analogButtons.r2),
+	};
+	AxisInput axes[AX_COUNT];
+	int count = 0;
+	for (int a = 0; a < AX_COUNT; a++) {
+		if (values[a] == pad.axes[a])
+			continue;
+		pad.axes[a] = values[a];
+		axes[count].deviceId = device;
+		axes[count].axisId = kAxisIds[a];
+		axes[count].value = values[a];
+		count++;
+	}
+	if (count)
+		NativeAxis(axes, count);
+}
+
+void UpdateVibration() {
+	const bool want = NowMs() < g_vibrateUntilMs.load();
+	if (want == g_vibrating || g_pads[0].handle < 0)
+		return;
+	g_vibrating = want;
+	OrbisPadVibeParam param{};
+	param.lgMotor = want ? 160 : 0;
+	param.smMotor = want ? 160 : 0;
+	scePadSetVibration(g_pads[0].handle, &param);
+}
+
+}  // namespace
+
+void Init() {
+	std::lock_guard<std::mutex> guard(g_lock);
+	const int r = scePadInit();
+	if (r != 0)
+		ERROR_LOG(Log::System, "PS4Pad: scePadInit failed: %08x", r);
+	Rescan();
+}
+
+void Poll() {
+	std::lock_guard<std::mutex> guard(g_lock);
+	// sign-ins and sign-outs, about twice a second
+	if (--g_rescanCountdown <= 0) {
+		g_rescanCountdown = 120;
+		Rescan();
+	}
+	for (int slot = 0; slot < kMaxPads; slot++) {
+		if (g_pads[slot].handle >= 0)
+			ReadPad(slot);
+	}
+	UpdateVibration();
+}
+
+void Shutdown() {
+	std::lock_guard<std::mutex> guard(g_lock);
+	for (Pad &pad : g_pads) {
+		if (pad.handle >= 0)
+			scePadClose(pad.handle);
+		pad = Pad();
+	}
+}
+
+void Vibrate(int lengthMs) {
+	if (lengthMs < 0)
+		lengthMs = 30;  // the haptic "feedback" constants
+	g_vibrateUntilMs = NowMs() + lengthMs;
+}
+
+}  // namespace PS4Pad
